createLabel("ИГРОКИ (ESP)", VisualsTab)
local isESPEnabled = createToggle("Включить подсветку", VisualsTab)
local espHighlights = {}

connectSignal(RunService.RenderStepped, function()
    if isESPEnabled() then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not espHighlights[player] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = player.Character
                    espHighlights[player] = hl
                elseif espHighlights[player].Parent ~= player.Character then
                    espHighlights[player].Parent = player.Character
                end
            end
        end
    else
        for player, hl in pairs(espHighlights) do
            if hl and hl.Parent then hl:Destroy() end
        end
        table.clear(espHighlights)
    end
end)

connectSignal(Players.PlayerRemoving, function(player)
    if espHighlights[player] then
        espHighlights[player]:Destroy()
        espHighlights[player] = nil
    end
end)

-- TELEPORTS
local function teleportTo(targetPos, keepVehicle)
    local root = getCharRoot(keepVehicle)
    if not root then return end
    
    local model = root:FindFirstAncestorWhichIsA("Model") or root.Parent
    local startPos = root.Position
    local dist = (startPos - targetPos).Magnitude
    
    -- If very close, just jump there instantly
    if dist < 20 then
        model:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
        return
    end
    
    -- Anti-cheat limit is strict (~75 studs/sec max)
    -- We will use 50 studs/sec to be extra safe from "Anti-cheat rollback (AntiTp)"
    local time = dist / 50
    if time < 0.2 then time = 0.2 end
    
    local startTime = tick()
    local conn
    
    -- Hold the player in air safely during teleport
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    
    conn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent or not model.Parent then
            if bv then bv:Destroy() end
            conn:Disconnect()
            return
        end
        
        local elapsed = tick() - startTime
        local alpha = elapsed / time
        
        if alpha >= 1 then
            model:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
            if bv then bv:Destroy() end
            conn:Disconnect()
        else
            local currentPos = startPos:Lerp(targetPos + Vector3.new(0, 3, 0), alpha)
            model:PivotTo(CFrame.new(currentPos))
        end
        
        if root:IsA("BasePart") then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

