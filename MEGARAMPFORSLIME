    ContentLayout.Padding = UDim.new(0, 10)
    ContentLayout.Parent = TabContent

    TabBtn.MouseButton1Click:Connect(function()
        for _, child in ipairs(Container:GetChildren()) do
            if child:IsA("Frame") and child ~= TabContent then
                child.Visible = false
            end
        end
        for _, child in ipairs(TabContainer:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                child.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
        TabContent.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        -- Update CanvasSize
        task.wait(0.1)
        Container.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
    end)
    
    if not activeTab then
        activeTab = TabBtn
        TabContent.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    return TabContent
end


