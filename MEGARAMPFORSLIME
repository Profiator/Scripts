-- Свободный полет (Fly)
local flying = false
local bg, bv

local function getFlyPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    
    -- Если игрок сидит в машине, берем машину для полета!
    if humanoid and humanoid.SeatPart then
        local vehicle = humanoid.SeatPart.Parent
        return vehicle.PrimaryPart or humanoid.SeatPart
    end
    
    return char:FindFirstChild("HumanoidRootPart")
end

local function startFly(flyPart)
    if flying then return end
    flying = true
    
    bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = flyPart.CFrame
    bg.Parent = flyPart
    
    bv = Instance.new("BodyVelocity")
    bv.velocity = Vector3.new(0, 0, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = flyPart
end

local function stopFly()
    if not flying then return end
    flying = false
    if bg then bg:Destroy(); bg = nil end
    if bv then bv:Destroy(); bv = nil end
end

RunService.RenderStepped:Connect(function()
    if getFly() then
        local flyPart = getFlyPart()
        if flyPart then
            -- Перезапускаем полет, если игрок сел или вышел из машины
            if not flying or (bg and bg.Parent ~= flyPart) then
                stopFly()
                startFly(flyPart)
            end
            
            if flying and bg and bv then
                local camera = Workspace.CurrentCamera
                bg.cframe = CFrame.new(camera.CFrame.p, camera.CFrame.p + camera.CFrame.lookVector)
                
                local moveDir = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                
                bv.velocity = moveDir.Magnitude > 0 and moveDir.Unit * getSpeedValue() or Vector3.new(0, 0, 0)
            end
        end
    else
        stopFly()
    end
end)
