local function createToggle(name, yPos)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Parent = MainFrame
    ToggleFrame.BackgroundTransparency = 1
    ToggleFrame.Position = UDim2.new(0, 12, 0, yPos)
    ToggleFrame.Size = UDim2.new(1, -24, 0, 30)

    local Label = Instance.new("TextLabel")
    Label.Parent = ToggleFrame
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(0.8, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 16
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Checkbox = Instance.new("TextButton")
    Checkbox.Parent = ToggleFrame
    Checkbox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Checkbox.BorderColor3 = Color3.fromRGB(100, 100, 100)
    Checkbox.Position = UDim2.new(1, -24, 0.5, -12)
    Checkbox.Size = UDim2.new(0, 24, 0, 24)
    Checkbox.Font = Enum.Font.GothamBold
    Checkbox.Text = ""
    Checkbox.TextColor3 = Color3.fromRGB(255, 255, 255)
    Checkbox.TextSize = 18

    local state = false
    Checkbox.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Checkbox.Text = "X"
            Checkbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            Checkbox.Text = ""
            Checkbox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        end
    end)

    return ToggleFrame, function() return state end, Checkbox
end

