local function teleportToLocation(name)
    local target = nil
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            if v.Name:lower():find(name:lower()) then
                target = v
                break
            end
        end
    end
    if target then
        local pos = target:IsA("Model") and (target.PrimaryPart and target.PrimaryPart.Position or target:GetModelCFrame().p) or target.Position
        teleportTo(pos + Vector3.new(0, 5, 0), false)
    end
end

