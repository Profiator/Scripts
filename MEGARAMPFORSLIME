-- MEGA RAMP FOR SLIME
-- Reconstructed from the original obfuscated script.
-- Original behavior preserved.
-- ONLY farm target changes:
--   Checkpoint "68" -> "92"
--   CFrame.new(-21, 3, 2101) -> CFrame.new(16.58, 4, 3304.53)

local CoreGui = game:GetService("CoreGui")
local OldGui = CoreGui:FindFirstChild("ToraScript")
if OldGui then
    OldGui:Destroy()
end

local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew",
    true
))()

local Window = Library:CreateWindow("MEGA RAMP FOR SLIME")

local function LastZone()
    while _G.LastZone do
        wait()

        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame =
            workspace.Progetto.CarSpawn.CFrame

        wait(1)

        for _, find in pairs(workspace:GetChildren()) do
            -- IMPORTANT: this is how the ORIGINAL script identifies the spawned car.
            -- It is PlayerName .. "_Auto", NOT just PlayerName.
            if find.Name == game.Players.LocalPlayer.Name .. "_Auto" then
                find:SetPrimaryPartCFrame(workspace.Progetto.JumpCar.CFrame)
                wait(0.2)

                -- ONLY TARGET CHANGE #1: original was Checkpoints["68"]
                find:SetPrimaryPartCFrame(workspace.Progetto.Checkpoints["92"].CFrame)
                wait(0.2)

                -- ONLY TARGET CHANGE #2: original was CFrame.new(-21, 3, 2101)
                find:SetPrimaryPartCFrame(CFrame.new(16.58, 4, 3304.53))
                wait(1)

                for _ = 1, 10 do
                    game:GetService("ReplicatedStorage").Remotes.OpenBoxClick:FireServer()
                end

                wait()
            end
        end
    end
end

local function Equip()
    while _G.Equip do
        game:GetService("ReplicatedStorage").Remotes.EquipBestInventory:FireServer()
        wait(2)
    end
end

Window:AddToggle({
    text = "Instant LastZone",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.LastZone = value
        print("LastZone: ", value)

        if value then
            spawn(LastZone)
        end
    end,
})

Window:AddToggle({
    text = "Equip Best",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.Equip = value
        print("Equip: ", value)

        if value then
            spawn(Equip)
        end
    end,
})

Window:AddLabel({
    text = "YouTube: Tora IsMe",
})

Library:Init()
