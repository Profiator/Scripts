local targetBlock = nil
local carSpawner = nil

-- Поиск блока x500000 и спавнера
task.spawn(function()
    while not targetBlock or not carSpawner do
        for _, v in pairs(Workspace:GetDescendants()) do
            -- Ищем блок x500000 по имени или тексту на нем
            if not targetBlock and v:IsA("BasePart") then
                if v.Name == "x500000" or v.Name == "500000" or string.find(v.Name, "500000") then
                    targetBlock = v
                else
                    for _, child in pairs(v:GetChildren()) do
                        if child:IsA("SurfaceGui") or child:IsA("BillboardGui") then
                            for _, lbl in pairs(child:GetDescendants()) do
                                if lbl:IsA("TextLabel") and (string.find(lbl.Text, "500000") or string.find(lbl.Text, "500,000")) then
                                    targetBlock = v
                                    break
                                end
                            end
                        end
                    end
                end
            end
            
            -- Ищем квадрат спавна машин (SpawnLocation или площадку рядом)
            if not carSpawner and v:IsA("SpawnLocation") then
                carSpawner = v
            end
        end
        task.wait(2)
    end
end)

-- Основной цикл авто-фарма
task.spawn(function()
    while task.wait(0.5) do
        if getInstantLastZone() then
            local character = LocalPlayer.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChild("Humanoid")
                
                if root and humanoid then
                    -- Если игрок не сидит в машине, телепортируем его к спавнеру машин
                    if not humanoid.SeatPart then
                        if carSpawner then
                            root.CFrame = carSpawner.CFrame + Vector3.new(0, 5, 0)
                            task.wait(1) -- Ждем пока игрок получит машину
                        else
                            -- Резервный телепорт далеко вперед если блок не найден
                            if targetBlock then
                                root.CFrame = targetBlock.CFrame + Vector3.new(0, 5, 0)
                            else
                                root.CFrame = CFrame.new(0, 500000, 0) 
                            end
                        end
                    else
                        -- Игрок сидит в машине, летим на x500000
                        local vehicle = humanoid.SeatPart.Parent
                        local vehicleRoot = vehicle.PrimaryPart or vehicle:FindFirstChild("DriveSeat") or root
                        
                        if targetBlock then
                            vehicleRoot.CFrame = targetBlock.CFrame + Vector3.new(0, 10, 0)
                        else
                            -- Если блок x500000 не найден, летим по прямой далеко вперед
                            vehicleRoot.CFrame = vehicleRoot.CFrame + vehicleRoot.CFrame.LookVector * 100000
                        end
                        
                        task.wait(1)
                        
                        -- Выпрыгиваем из машины чтобы получить награду
                        humanoid.Sit = false
                        task.wait(2)
                    end
                end
            end
        end
    end
end)

