local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

local data = {
    positions = {},
    zones = {},
    xChanges = {},
    finalX = 0,
    startTime = os.time()
}

-- Функция получения текущего X (из GUI или leaderstats)
local function getCurrentX()
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local txt = child.Text or ""
                    local num = tonumber(txt:match("(%d+)"))
                    if num and num > 100 then return num end
                end
            end
        end
    end
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local xStat = stats:FindFirstChild("X")
        if xStat and xStat:IsA("IntValue") then return xStat.Value end
    end
    return 0
end

local lastX = 0
local timer = 0

-- Сбор данных
RunService.Heartbeat:Connect(function(dt)
    timer = timer + dt
    if timer >= 0.1 then
        timer = 0
        if not RootPart then return end
        local pos = RootPart.Position
        local x = getCurrentX()
        table.insert(data.positions, {x = pos.X, y = pos.Y, z = pos.Z, time = os.time(), xVal = x})
        if x ~= lastX then
            table.insert(data.xChanges, {from = lastX, to = x, pos = {x = pos.X, y = pos.Y, z = pos.Z}})
            lastX = x
        end
        -- Поиск зон рядом
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                local dist = (part.Position - RootPart.Position).Magnitude
                if dist < 15 then
                    local name = part.Name:lower()
                    if name:find("zone") or name:find("trigger") or name:find("checkpoint") or name:find("ramp") then
                        local key = part.Name .. "_" .. tostring(part.Position)
                        if not data.zones[key] then
                            data.zones[key] = {name = part.Name, pos = {x = part.Position.X, y = part.Position.Y, z = part.Position.Z}}
                        end
                    end
                end
            end
        end
    end
end)

-- Авто-остановка через 90 секунд (или вручную командой /stoplog)
wait(90)
data.finalX = getCurrentX()
data.endTime = os.time()

-- Вывод отчёта
print("=== АНАЛИЗ ЗАВЕРШЁН ===")
print("Всего точек: " .. #data.positions)
print("Изменений X: " .. #data.xChanges)
print("Найдено зон: " .. #data.zones)
print("Финальный X: " .. data.finalX)
print("\nСПИСОК ЗОН (имя и координаты):")
for key, zone in pairs(data.zones) do
    print(string.format("  %s -> (%.1f, %.1f, %.1f)", zone.name, zone.pos.x, zone.pos.y, zone.pos.z))
end
print("=== КОНЕЦ ===")
warn("Скопируйте этот вывод и отправьте мне.")
