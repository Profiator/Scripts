local targetBlock = nil
local carSpawner = nil

-- Поиск блока x500000 и спавнера машин
task.spawn(function()
    while task.wait(2) do
        if not targetBlock then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local n = string.lower(v.Name)
                    if string.find(n, "500000") or string.find(n, "500,000") or string.find(n, "lastzone") then
                        targetBlock = v
                        break
                    end
                elseif v:IsA("TextLabel") or v:IsA("TextButton") then
                    local t = string.lower(v.Text)
                    if string.find(t, "500000") or string.find(t, "500,000") then
                        local gui = v:FindFirstAncestorWhichIsA("SurfaceGui")
                        if gui and gui.Adornee then
                            targetBlock = gui.Adornee
                            break
                        elseif gui and gui.Parent and gui.Parent:IsA("BasePart") then
                            targetBlock = gui.Parent
                            break
                        end
                    end
                end
            end
        end
        if not carSpawner then
            local spawnLoc = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
            if spawnLoc then
                carSpawner = spawnLoc
            end
        end
    end
end)

-- Авто-Фарм
task.spawn(function()
    while task.wait(0.5) do
        if getInstantLastZone() then
            local character = LocalPlayer.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChild("Humanoid")
                
                if root and humanoid then
                    if not humanoid.SeatPart then
                        -- Телепорт к спавнеру машин
                        if carSpawner then
                            root.CFrame = carSpawner.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.5)
                            -- Двигаем персонажа вперед, чтобы взять машину
                            humanoid:MoveTo(root.Position + root.CFrame.LookVector * 15)
                            task.wait(1)
                        end
                    else
                        -- Игрок в машине, летим на x500000
                        local vehicle = humanoid.SeatPart.Parent
                        local vehicleRoot = vehicle.PrimaryPart or humanoid.SeatPart
                        
                        if targetBlock then
                            vehicleRoot.CFrame = targetBlock.CFrame + Vector3.new(0, 5, 0)
                            -- Замораживаем физику, чтобы машина не улетела
                            vehicleRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            vehicleRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        else
                            vehicleRoot.CFrame = vehicleRoot.CFrame + vehicleRoot.CFrame.LookVector * 100000
                        end
                        
                        task.wait(0.5)
                        humanoid.Sit = false -- Выпрыгиваем для получения награды
                        task.wait(1)
                    end
                end
            end
        end
    end
end)

