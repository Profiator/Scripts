local function TeleportToStart()
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(TARGET_CFRAME)
    end
end

local function GetRootPart()
    local character = LocalPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local model = seat:FindFirstAncestorOfClass("Model") or seat.Parent
        return model.PrimaryPart or seat
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function GetClickPosition(button)
    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    return pos.X + size.X / 2, pos.Y + size.Y / 2 + inset.Y
end

local function MoveToPosition(targetPos)
    local root = GetRootPart()
    if not root then return end
    local startPos = root.Position
    local distance = (startPos - targetPos).Magnitude
    if distance < 1 then return end
    local duration = distance / MOVE_SPEED
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local model = root:FindFirstAncestorOfClass("Model")
    if model and model.PrimaryPart == root then
        local startCF = model:GetPivot()
        local endCF = CFrame.new(targetPos) * (startCF - startCF.Position)
        local cframeValue = Instance.new("CFrameValue")
        cframeValue.Value = startCF
        local connection = cframeValue.Changed:Connect(function(v)
            model:PivotTo(v)
        end)
        local tween = TweenService:Create(cframeValue, tweenInfo, {Value = endCF})
        tween:Play()
        tween.Completed:Wait()
        connection:Disconnect()
        cframeValue:Destroy()
    else
        local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
        tween:Play()
        tween.Completed:Wait()
    end
end

local function ClickCloseButton()
    local mainUI = PlayerGui:FindFirstChild("MainGameUI")
    if not mainUI then return end
    local sellFrame = mainUI:FindFirstChild("SellSlimeFrame")
    if not sellFrame or not sellFrame.Visible then return end

    local closeBtn = sellFrame:FindFirstChild("Close") or
                     sellFrame:FindFirstChild("CloseButton") or
                     sellFrame:FindFirstChild("X")
    if closeBtn then
        local x, y = GetClickPosition(closeBtn)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        pcall(function()
            sellFrame.Visible = false
        end)
    end
end

local function WaitForSellFrameClosed()
    local mainUI = PlayerGui:FindFirstChild("MainGameUI")
    if not mainUI then return true end
    for i = 1, 40 do
        local sellFrame = mainUI:FindFirstChild("SellSlimeFrame")
        if not sellFrame or not sellFrame.Visible then
            return true
        end
        ClickCloseButton()
        task.wait(0.2)
    end
    return false
end

local function StartFarming()
    isFarming = not isFarming

    if isFarming then
        FarmButton.Text = "[ FARM: ACTIVE ]"
        FarmButton.BackgroundColor3 = Color3.fromRGB(15, 25, 30)
        FarmStroke.Color = Color3.fromRGB(0, 150, 255)
        isJumping = false

        TeleportToStart()

        local invConn = InventoryUpdate.OnClientEvent:Connect(function(data)
            if type(data) == "table" then
                currentInventory = data
            end
        end)

        local jumpConn = JumpLuckStart.OnClientEvent:Connect(function()
            if not isFarming then return end
            isJumping = true
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            local root = GetRootPart()
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            MoveToPosition(TARGET_POSITION)
            isJumping = false
        end)

        local endBoxConn = EndBoxReveal.OnClientEvent:Connect(function()
            if not isFarming or isJumping then return end
            isJumping = true
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)

            local waitCount = 0
            while (not currentInventory or #currentInventory == 0) and waitCount < 30 do
                task.wait(0.15)
                waitCount = waitCount + 1
            end

            if currentInventory and #currentInventory > 0 then
                for _, item in ipairs(currentInventory) do
                    local rarity = tostring(item.Rarity or ""):upper()
                    local index = item.InventoryIndex
                    if index and RARITY_FILTERS[rarity] == true then
                        pcall(function()
                            SellSlimeAction:FireServer("Sell", index)
                            task.wait(0.05)
                        end)
                    end
                end
            end

            task.wait(0.5)
            WaitForSellFrameClosed()
            task.wait(0.5)
            isJumping = false
        end)

        local moveThread = task.spawn(function()
            while isFarming do
                if isJumping then
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                    task.wait(0.3)
                else
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                    task.wait(math.random(15, 25) / 10)
                    if not isJumping then
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                        task.wait(math.random(5, 15) / 10)
                    end
                end
            end
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)

        local clickThread = task.spawn(function()
            while isFarming do
                if isJumping then
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(0.3)
                else
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(0.12)
                end
            end
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)

        _G._farmThreads = {
            move = moveThread,
            click = clickThread,
            inv = invConn,
            jump = jumpConn,
            endBox = endBoxConn
        }

    else
        FarmButton.Text = "[ FARM: OFF ]"
        FarmButton.BackgroundColor3 = Color3.fromRGB(18, 15, 22)
        FarmStroke.Color = Color3.fromRGB(255, 50, 80)
        isJumping = false

        if _G._farmThreads then
            if _G._farmThreads.move then task.cancel(_G._farmThreads.move) end
            if _G._farmThreads.click then task.cancel(_G._farmThreads.click) end
            if _G._farmThreads.inv then _G._farmThreads.inv:Disconnect() end
            if _G._farmThreads.jump then _G._farmThreads.jump:Disconnect() end
            if _G._farmThreads.endBox then _G._farmThreads.endBox:Disconnect() end
            _G._farmThreads = nil
        end

        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

