                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    teleportTo(p.Character.HumanoidRootPart.Position, true)
                end
            end)
            
            ySize = ySize + 40
        end
    end
    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

