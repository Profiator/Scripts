-- FLY & SPEED
createLabel("SPEED & FLY (UNDETECTED CFrame)", MainTab)
local isCustomSpeed = createToggle("Enable Custom Speed", MainTab)
local getSpeed = createSlider("Speed", 16, 300, 50, MainTab)
local isFlyEnabled = createToggle("Free Fly", MainTab)

local flying = false

connectSignal(RunService.RenderStepped, function(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    local root = getCharRoot(true)
    
    if not humanoid or not root then return end

    if isCustomSpeed() and not isFlyEnabled() then
        if humanoid.MoveDirection.Magnitude > 0 then
            local speedDiff = getSpeed() - humanoid.WalkSpeed
            if speedDiff > 0 then
                local displacement = humanoid.MoveDirection * (speedDiff * deltaTime)
                if root:IsA("BasePart") then
                    root.CFrame = root.CFrame + displacement
                end
            end
        end
    end

    if isFlyEnabled() then
        if not flying then
            flying = true
            if root:IsA("BasePart") then
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
        
        if root:IsA("BasePart") then
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        
        local moveDir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.lookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.lookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.rightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.rightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        local currentSpeed = isCustomSpeed() and getSpeed() or 50
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
            root.CFrame = root.CFrame + (moveDir * currentSpeed * deltaTime)
        end
    else
        if flying then
            flying = false
        end
    end
end)

-- AIMBOT
createLabel("AIMBOT SETTINGS (HOLD Q TO AIM)", AimbotTab)
local isAimbotEnabled = createToggle("Enable Aimbot", AimbotTab)
local aimbotTarget = nil

local function getClosestPlayerToCursor()
    local closestDist = math.huge
    local closestPlayer = nil
    local mouse = LocalPlayer:GetMouse()
    local mousePos = Vector2.new(mouse.X, mouse.Y)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlayer = p
                end
            end
        end
    end
    return closestPlayer
end

connectSignal(UserInputService.InputBegan, function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q and isAimbotEnabled() then
        aimbotTarget = getClosestPlayerToCursor()
    end
end)

connectSignal(UserInputService.InputEnded, function(input, gpe)
    if input.KeyCode == Enum.KeyCode.Q then
        aimbotTarget = nil
    end
end)

connectSignal(RunService.RenderStepped, function()
    if isAimbotEnabled() and aimbotTarget and aimbotTarget.Character and aimbotTarget.Character:FindFirstChild("Head") and UserInputService:IsKeyDown(Enum.KeyCode.Q) then
        local headPos = aimbotTarget.Character.Head.Position
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, headPos)
    end
end)

