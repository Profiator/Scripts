-- MEGA RAMP FOR SLIME
-- Stable x1,000,000 farm
-- Important: does NOT run through every multiplier pad.
-- It mirrors the original cycle: spawn -> find player's car -> move once -> wait -> repeat.

local TARGET_MULTIPLIER = 1000000
local AFTER_SPAWN_DELAY = 0.25
local AFTER_MOVE_DELAY = 1.0

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Remove old UI copy.
local oldGui = CoreGui:FindFirstChild("ToraScript")
if oldGui then
    oldGui:Destroy()
end

-- Same UI library as the original script.
local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew",
    true
))()

local Window = Library:CreateWindow("MEGA RAMP FOR SLIME")

local function parseMultiplier(text)
    text = tostring(text or "")
        :upper()
        :gsub("%s+", "")
        :gsub(",", "")
        :gsub("%.", "")

    local n = text:match("X(%d+)")
    return n and tonumber(n) or nil
end

local function basePartFromTextObject(obj)
    local current = obj

    for _ = 1, 10 do
        if not current then
            return nil
        end

        if current:IsA("SurfaceGui") or current:IsA("BillboardGui") then
            local ok, adornee = pcall(function()
                return current.Adornee
            end)
            if ok and adornee and adornee:IsA("BasePart") then
                return adornee
            end
        end

        if current:IsA("BasePart") then
            return current
        end

        current = current.Parent
    end

    return nil
end

-- Find ONLY the x1,000,000 pad.
local function findTargetPad()
    local bestPart = nil

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local ok, text = pcall(function()
                return obj.Text
            end)

            if ok and parseMultiplier(text) == TARGET_MULTIPLIER then
                local part = basePartFromTextObject(obj)
                if part then
                    return part
                end
            end
        elseif obj:IsA("BasePart") and parseMultiplier(obj.Name) == TARGET_MULTIPLIER then
            bestPart = obj
        end
    end

    return bestPart
end

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- This is taken from the behavior recovered from the original obfuscated script.
local function movePlayerToCarSpawn()
    local character = getCharacter()
    local root = character:FindFirstChild("HumanoidRootPart")
    local progetto = workspace:FindFirstChild("Progetto")
    local carSpawn = progetto and progetto:FindFirstChild("CarSpawn")

    if root and carSpawn and carSpawn:IsA("BasePart") then
        root.CFrame = carSpawn.CFrame
        return true
    end

    return false
end

-- Original script scans workspace:GetChildren() and compares Name with LocalPlayer.Name.
local function findPlayerCar()
    for _, object in ipairs(workspace:GetChildren()) do
        if object.Name == LocalPlayer.Name and object ~= LocalPlayer.Character then
            return object
        end
    end

    -- Small fallback for versions where the car is moved under a folder/model.
    for _, object in ipairs(workspace:GetDescendants()) do
        if object.Name == LocalPlayer.Name and object ~= LocalPlayer.Character then
            if object:IsA("Model") or object:IsA("BasePart") then
                return object
            end
        end
    end

    return nil
end

local function targetCFrameForPad(part)
    -- One destination only. Do not traverse intermediate multiplier pads.
    -- A small height offset lets the vehicle contact/settle onto the pad.
    return part.CFrame * CFrame.new(0, (part.Size.Y * 0.5) + 2.5, 0)
end

local function moveCarOnce(car, targetPart)
    if not car or not targetPart then
        return false
    end

    local cf = targetCFrameForPad(targetPart)

    if car:IsA("Model") then
        -- Prefer the same SetPrimaryPartCFrame style seen in the original script.
        if car.PrimaryPart then
            local ok = pcall(function()
                car:SetPrimaryPartCFrame(cf)
            end)
            if ok then
                return true
            end
        end

        -- Robust fallback for models without PrimaryPart.
        local ok = pcall(function()
            car:PivotTo(cf)
        end)
        if ok then
            return true
        end

        local part = car:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local ok2 = pcall(function()
                part.CFrame = cf
            end)
            if ok2 then
                return true
            end
        end
    elseif car:IsA("BasePart") then
        car.CFrame = cf
        return true
    end

    return false
end

local function LastZone()
    while _G.LastZone do
        -- 1) Same beginning as the original: return player to CarSpawn.
        movePlayerToCarSpawn()
        task.wait(AFTER_SPAWN_DELAY)

        if not _G.LastZone then
            break
        end

        -- 2) Get the player's spawned vehicle.
        local car = findPlayerCar()

        -- 3) Find exactly x1,000,000. No intermediate-zone loop.
        local target = findTargetPad()

        if car and target then
            moveCarOnce(car, target)
        elseif not target then
            warn("[x1M] x1,000,000 pad not found")
        elseif not car then
            warn("[x1M] Player car not found yet")
        end

        -- 4) Give the game time to register the hit/reward/reset before next run.
        task.wait(AFTER_MOVE_DELAY)
    end
end

local function Equip()
    while _G.Equip do
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local remote = remotes and remotes:FindFirstChild("EquipBestInventory")

        if remote then
            remote:FireServer()
        end

        task.wait(2)
    end
end

Window:AddToggle({
    text = "Instant LastZone [x1M STABLE]",
    flag = "toggle_x1m_stable",
    state = false,
    callback = function(value)
        _G.LastZone = value
        print("LastZone x1M:", value)

        if value then
            task.spawn(LastZone)
        end
    end,
})

Window:AddToggle({
    text = "Equip Best",
    flag = "toggle_equip",
    state = false,
    callback = function(value)
        _G.Equip = value
        print("Equip:", value)

        if value then
            task.spawn(Equip)
        end
    end,
})

Window:AddLabel({
    text = "Target: x1,000,000",
})

Window:AddLabel({
    text = "YouTube: Tora IsMe",
})

Library:Init()
