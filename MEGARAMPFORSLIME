local window = { x = 150, y = 80, w = 600, h = 500 }
local function createRect(x, y, w, h, color, transparency)
    local rect = Drawing.new("Square")
    rect.Position = Vector2.new(x, y)
    rect.Size = Vector2.new(w, h)
    rect.Color = color
    rect.Transparency = transparency or 1
    rect.Thickness = 1
    rect.Filled = true
    rect.ZIndex = 10
    return rect
end
local function createText(x, y, text, size, color, center)
    local txt = Drawing.new("Text")
    txt.Position = Vector2.new(x, y)
    txt.Text = text
    txt.Size = size or 16
    txt.Color = color or Color3.fromRGB(255,255,255)
    txt.Center = center or false
    txt.ZIndex = 11
    return txt
end

