local legitPosition = nil
connectSignal(RunService.Heartbeat, function(dt)
    local hrp = getCharRoot()
    if hrp then
        if not legitPosition then
            legitPosition = hrp.Position
        else
            if isFlyEnabled() or isCustomSpeed() or speedHoldActive or isFarmPlaying or isTPing then
                local dist = (hrp.Position - legitPosition).Magnitude
                local maxMove = 28 * dt -- Safe speed limit to bypass AC (28 studs/sec)
                if dist > maxMove then
                    legitPosition = legitPosition + (hrp.Position - legitPosition).Unit * maxMove
                else
                    legitPosition = hrp.Position
                end
            else
                legitPosition = hrp.Position
            end
        end
    end
end)

