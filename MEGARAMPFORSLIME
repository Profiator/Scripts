-- 2. Функция форматирования чисел (1.500 вместо 1500)
local function FormatNum(num)
    local formatted = tostring(num)
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
        if k == 0 then break end
    end
    return formatted
end

-- 3. Функция добавления лога в UI
local function AddLog(message)
    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 0, 18)
    TextLabel.BackgroundTransparency = 1
    TextLabel.Text = message
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.Font = Enum.Font.Code
    TextLabel.TextSize = 13
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.Parent = LogList
    
    -- Автопрокрутка вниз
    task.wait(0.05)
    LogList.CanvasPosition = Vector2.new(0, LogList.AbsoluteCanvasSize.Y)
end

-- 4. Логика множителей X (как на скринах)
local currentX = 5
local currentCP = 1
local luckEnded = false

local function GetNextX()
    if currentX < 100 then return currentX + 5
    elseif currentX < 1000 then return currentX + 50
    elseif currentX < 10000 then return currentX + 500
    elseif currentX < 100000 then return currentX + 5000
    elseif currentX < 500000 then return currentX + 50000
    else return currentX end
end

-- 5. Функция срабатывания при касании
local function OnTouched(hit)
    if luckEnded then return end
    
    -- Проверяем, что коснулся игрок или его транспорт (машина JumpCar)
    local Character = Player.Character
    if not Character then return end
    
    local IsPlayer = (hit.Parent == Character)
    local IsVehicle = (hit.Parent:IsA("VehicleSeat") and hit.Parent:FindFirstChild("SeatWeld") and hit.Parent.SeatWeld.Part0 == Character)
    
    if IsPlayer or IsVehicle then
        local nextX = GetNextX()
        local nextCP = currentCP + 1
        local formattedX = FormatNum(nextX)
        
        local msg = string.format("Checkpoint UI: %d x%s Label: x%s", currentCP, formattedX, formattedX)
        AddLog(msg)
        
        currentX = nextX
        currentCP = nextCP
        
        -- Финальный чекпоинт
        if nextX >= 500000 then
            AddLog("Luck UI end")
            luckEnded = true
        end
    end
end

-- 6. Поиск чекпоинтов в мире
AddLog("-- System: Поиск чекпоинтов...")
task.wait(0.5)

local hookCount = 0
for _, v in pairs(workspace:GetDescendants()) do
    -- Ищем части с названием "Checkpoint" или "CP"
    if v:IsA("BasePart") and (string.find(v.Name, "Checkpoint") or string.find(v.Name, "CP")) then
        v.Touched:Connect(OnTouched)
        hookCount = hookCount + 1
    end
end

