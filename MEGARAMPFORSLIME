-- Убраны все манипуляции с античитом, которые могли вызывать мгновенную смерть.
-- Скрипт теперь 100% пассивный при инжекте и не трогает метатаблицы.

local function getCharRoot(preferVehicle)
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if preferVehicle and humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local vehicle = humanoid.SeatPart:FindFirstAncestorWhichIsA("Model")
        if vehicle and vehicle.PrimaryPart then
            return vehicle.PrimaryPart
        end
        return humanoid.SeatPart
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- Server-Side Teleport Bypass (Uses internal game remotes)
local function teleportTo(targetPos, keepVehicle)
    local root = getCharRoot(keepVehicle)
    if not root then return end
    
    local char = root.Parent
    if char and char:IsA("Model") then
        pcall(function()
            if root:IsA("BasePart") then
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end)
        char:PivotTo(CFrame.new(targetPos))
    end
end

