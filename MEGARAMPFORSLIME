local isMenuVisible = true
connectSignal(UserInputService.InputBegan, function(input, gpe)
    if isBindingKey and input.UserInputType == Enum.UserInputType.Keyboard then
        currentToggleKey = input.KeyCode
        bindButton.Text = currentToggleKey.Name
        bindButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        isBindingKey = false
        return
    end
    if not gpe and input.KeyCode == currentToggleKey then
        isMenuVisible = not isMenuVisible
        MainFrame.Visible = isMenuVisible
    end
end)
