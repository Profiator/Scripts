pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index
    local oldNewIndex = mt.__newindex
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            if method == "Kick" or method == "kick" then
                return nil
            elseif method == "Teleport" or method == "TeleportToPlaceInstance" then
                return nil
            elseif method == "FireServer" or method == "InvokeServer" then
                local name = tostring(self):lower()
                if name:find("ban") or name:find("kick") or name:find("punish") or name:find("cheat") or name:find("log") or name:find("detect") or name:find("anticheat") or name:find("report") or name:find("crash") or name:find("error") or name:find("suspicious") or name:find("exploit") or name:find("admin") then
                    return nil
                end
            elseif method == "FindFirstChild" or method == "FindFirstChildOfClass" or method == "FindFirstChildWhichIsA" then
                local args = {...}
                if type(args[1]) == "string" then
                    local n = tostring(args[1])
                    if n == "BodyVelocity" or n == "BodyGyro" or n == "BodyForce" or n == "BodyPosition" or n == "RocketPropulsion" or n == "AlignPosition" or n == "AlignOrientation" then
                        local lp = game:GetService("Players").LocalPlayer
                        if lp and lp.Character and self:IsDescendantOf(lp.Character) then
                            return nil
                        end
                    end
                end
            end
        end
        
        if _G.ActionRecorder and _G.ActionRecorder.Recording then
            local args = {...}
            pcall(function()
                if method == "FireServer" or method == "InvokeServer" then
                    local argStr = ""
                    for i, v in ipairs(args) do
                        local vStr = "<err>"
                        pcall(function()
                            if typeof(v) == "Instance" then
                                vStr = v.Name
                            else
                                vStr = tostring(v)
                            end
                        end)
                        argStr = argStr .. typeof(v) .. "(" .. vStr .. "), "
                    end
                    local selfName = "<err>"
                    pcall(function() selfName = self.Name end)
                    
                    local logMsg = string.format("[%s] %s: %s | Args: %s", os.date("%X"), method, selfName, argStr)
                    table.insert(_G.ActionRecorder.Logs, logMsg)
                    print("[ActionRecorder]", logMsg)
                end
            end)
        end

        return oldNamecall(self, ...)
    end)

    mt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if key == "WalkSpeed" then return 16 end
            if key == "JumpPower" then return 50 end
            if key == "JumpHeight" then return 7.2 end
            if key == "Transparency" and self:IsA("BasePart") then return 0 end
            if key == "Velocity" or key == "AssemblyLinearVelocity" then return Vector3.new(0,0,0) end
            if key == "CFrame" and typeof(self) == "Instance" and self:IsA("HumanoidRootPart") then
                -- Optional: Spoof CFrame if needed, but usually breaks the game. We leave it as is.
            end
        end
        return oldIndex(self, key)
    end)
    
    mt.__newindex = newcclosure(function(self, key, value)
        if not checkcaller() then
            if key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" then return end
        end
        return oldNewIndex(self, key, value)
    end)

    setreadonly(mt, true)
    
    local ScriptContext = game:GetService("ScriptContext")
    local LogService = game:GetService("LogService")
    
    for _, conn in ipairs(getconnections(ScriptContext.Error)) do
        conn:Disable()
    end
    for _, conn in ipairs(getconnections(LogService.MessageOut)) do
        conn:Disable()
    end

    print("[MEGA RAMP LOG] God-Level Anti-Cheat bypass active")
end)

