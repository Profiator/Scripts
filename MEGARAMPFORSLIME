-- LOGIC

local function getCharRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and humanoid.SeatPart then
        local vehicle = humanoid.SeatPart.Parent
        return vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart") or humanoid.SeatPart
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(cframe)
    local root = getCharRoot()
    if root then
        -- Если мы в машине, нужно обнулить скорость перед тп
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.CFrame = cframe
    end
end

-- Авто-Фарм Цикл
task.spawn(function()
    while true do
        task.wait(0.1)
        if isAutoFarmEnabled() and startCFrame and endCFrame then
            -- 1. ТП на Старт
            teleportTo(startCFrame)
            task.wait(1.5) -- Ждем пока сядет в машину или прогрузится
            
            -- 2. ТП на Финиш
            if isAutoFarmEnabled() then
                teleportTo(endCFrame)
                task.wait(0.5)
                
                -- 3. Зажимаем ЛКМ на 3 секунды
                if isAutoFarmEnabled() then
                    VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                    task.wait(3)
                    VirtualUser:Button1Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                end
            end
        end
    end
end)

