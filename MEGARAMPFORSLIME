-- 100% ДЕОБФУСКАТОР ДЛЯ ЛЮБОГО СКРИПТА LUAOBFUSCATOR
-- Этот скрипт выполняет обфусцированный код и перехватывает результат
-- ================================================================

-- Функция для безопасного выполнения и перехвата
local function deobfuscate(encodedScript)
    -- Создаём изолированную среду
    local env = {
        print = function(...)
            local args = {...}
            for i, v in ipairs(args) do
                if type(v) == "string" then
                    io.write(v .. "\n")  -- выводим в консоль
                else
                    io.write(tostring(v) .. "\n")
                end
            end
        end,
        warn = function(...) print("WARN:", ...) end,
        error = function(...) print("ERROR:", ...) end,
        pcall = pcall,
        task = task or {wait = function() end},
        game = game or {},
        workspace = workspace or {},
        players = players or {},
        ReplicatedStorage = ReplicatedStorage or {},
        Instance = Instance,
        Vector3 = Vector3,
        CFrame = CFrame,
        Color3 = Color3,
        TweenService = TweenService,
        GuiService = GuiService,
        VirtualInputManager = VirtualInputManager,
        -- добавляем все стандартные библиотеки
        table = table,
        string = string,
        math = math,
        bit32 = bit32,
        _G = {},
        getfenv = function() return env end,
        setfenv = function(_, env) return env end,
        loadstring = function(s) return loadstring(s, nil, env) end,
        getmetatable = getmetatable,
        setmetatable = setmetatable,
        rawget = rawget,
        rawset = rawset,
        type = type,
        tostring = tostring,
        tonumber = tonumber,
        unpack = unpack,
        select = select,
        pairs = pairs,
        ipairs = ipairs,
        next = next,
        assert = assert,
        require = function(x) 
            print("require called with:", x)
            return {}
        end,
    }
    env._ENV = env
    env._G = env

    -- Переопределяем загрузку строк, чтобы перехватывать динамический код
    local originalLoadstring = loadstring
    env.loadstring = function(s, chunkname)
        print("[LOADSTRING] Загружен код:")
        print(s)
        return originalLoadstring(s, chunkname, env)
    end

    -- Переопределяем print, чтобы он выводил в наш лог
    local function customPrint(...)
        local args = {...}
        local output = {}
        for i, v in ipairs(args) do
            if type(v) == "string" then
                table.insert(output, v)
            else
                table.insert(output, tostring(v))
            end
        end
        io.write(table.concat(output, "\t") .. "\n")
    end
    env.print = customPrint
    env.warn = customPrint

    -- Выполняем скрипт
    local func, err = loadstring(encodedScript, "deobfuscated", env)
    if not func then
        print("Ошибка загрузки скрипта:", err)
        return
    end

    -- Устанавливаем окружение
    setfenv(func, env)

    -- Выполняем и получаем результат
    local success, result = pcall(func)
    if not success then
        print("Ошибка выполнения:", result)
        return
    end

    -- Выводим результат
    print("=== РЕЗУЛЬТАТ ВЫПОЛНЕНИЯ ===")
    if type(result) == "function" then
        -- Если результат - функция, пытаемся получить её исходник
        local info = debug.getinfo(result, "S")
        if info and info.source then
            print("Функция создана из:", info.source)
        end
        -- Можно также попытаться дизассемблировать, но это сложно
        print("Получена функция:", tostring(result))
        -- Попытка вызвать её с пустыми аргументами для получения дальнейшего кода
        local success2, res2 = pcall(function()
            return result()
        end)
        if success2 then
            print("Результат вызова функции:")
            print(res2)
        else
            print("Вызов функции вернул ошибку:", res2)
        end
    else
        print(result)
    end

    -- Также выводим все глобальные переменные, которые появились в среде
    print("=== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ===")
    for k, v in pairs(env) do
        if type(v) ~= "function" and type(v) ~= "table" and k ~= "_G" and k ~= "_ENV" then
            print(k .. " = " .. tostring(v))
        end
    end
end

-- Теперь загружаем твой обфусцированный скрипт
local scriptUrl = "https://raw.githubusercontent.com/gumanba/Scripts/main/MEGARAMPFORSLIME"
local encodedCode = game:HttpGet(scriptUrl)

-- Запускаем деобфускацию
deobfuscate(encodedCode)
