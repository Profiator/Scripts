-- АНАЛИЗАТОР С GUI ДЛЯ MEGA RAMP
-- Версия 2.0 – с управлением, логами и копированием

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- === ДАННЫЕ ДЛЯ СБОРА ===
local analysisData = {
    positions = {},
    zones = {},
    xChanges = {},
    keyLogs = {},
    gameEvents = {},
    finalX = 0,
    startTime = nil,
    endTime = nil,
    isRunning = false,
}

local lastX = 0
local timer = 0
local collecting = false

-- === ФУНКЦИЯ ПОЛУЧЕНИЯ ТЕКУЩЕГО X ===
local function getCurrentX()
    -- Из GUI
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local txt = child.Text or ""
                    local num = tonumber(txt:match("(%d+)"))
                    if num and num > 100 then return num end
                end
            end
        end
    end
    -- Из leaderstats
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local xStat = stats:FindFirstChild("X")
        if xStat and xStat:IsA("IntValue") then return xStat.Value end
    end
    return 0
end

-- === ФУНКЦИЯ ДОБАВЛЕНИЯ ЛОГА В GUI ===
local function addLog(text)
    if not logText then return end
    logText.Text = logText.Text .. text .. "\n"
    logText.CanvasPosition = Vector2.new(0, logText.TextBounds.Y)
end

-- === СБОР ДАННЫХ ===
local function startCollection()
    if collecting then return end
    collecting = true
    analysisData.startTime = os.time()
    analysisData.positions = {}
    analysisData.zones = {}
    analysisData.xChanges = {}
    analysisData.keyLogs = {}
    analysisData.gameEvents = {}
    lastX = getCurrentX()
    addLog("▶ АНАЛИЗ ЗАПУЩЕН " .. os.date("%H:%M:%S"))
    addLog("Начальный X: " .. lastX)
    -- Подписка на события
    connectionHeartbeat = RunService.Heartbeat:Connect(function(dt)
        if not collecting then return end
        timer = timer + dt
        if timer >= 0.1 then
            timer = 0
            if not RootPart then return end
            local pos = RootPart.Position
            local x = getCurrentX()
            table.insert(analysisData.positions, {x=pos.X, y=pos.Y, z=pos.Z, time=os.time(), xVal=x})
            if x ~= lastX then
                table.insert(analysisData.xChanges, {from=lastX, to=x, pos={x=pos.X, y=pos.Y, z=pos.Z}, time=os.time()})
                addLog("X изменился: " .. lastX .. " → " .. x .. " на (" .. string.format("%.1f", pos.X) .. ", " .. string.format("%.1f", pos.Y) .. ", " .. string.format("%.1f", pos.Z) .. ")")
                lastX = x
            end
            -- Поиск зон
            for _, part in ipairs(workspace:GetDescendants()) do
                if part:IsA("BasePart") then
                    local dist = (part.Position - RootPart.Position).Magnitude
                    if dist < 15 then
                        local name = part.Name:lower()
                        if name:find("zone") or name:find("trigger") or name:find("checkpoint") or name:find("ramp") then
                            local key = part.Name .. "_" .. tostring(part.Position)
                            if not analysisData.zones[key] then
                                analysisData.zones[key] = {name = part.Name, pos = {x = part.Position.X, y = part.Position.Y, z = part.Position.Z}}
                                addLog("Найдена зона: " .. part.Name .. " (" .. string.format("%.1f", part.Position.X) .. ", " .. string.format("%.1f", part.Position.Y) .. ", " .. string.format("%.1f", part.Position.Z) .. ")")
                            end
                        end
                    end
                end
            end
        end
    end)
    connectionKey = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not collecting then return end
        if gameProcessed then return end
        local key = input.KeyCode.Name
        table.insert(analysisData.keyLogs, {key=key, time=os.time()})
        addLog("Нажата клавиша: " .. key)
    end)
end

local function stopCollection()
    if not collecting then return end
    collecting = false
    analysisData.endTime = os.time()
    analysisData.finalX = getCurrentX()
    if connectionHeartbeat then connectionHeartbeat:Disconnect() end
    if connectionKey then connectionKey:Disconnect() end
    addLog("⏹ АНАЛИЗ ОСТАНОВЛЕН " .. os.date("%H:%M:%S"))
    addLog("Финальный X: " .. analysisData.finalX)
    addLog("Найдено зон: " .. #analysisData.zones)
    addLog("Изменений X: " .. #analysisData.xChanges)
    addLog("Нажатий клавиш: " .. #analysisData.keyLogs)
    addLog("=== КОНЕЦ АНАЛИЗА ===")
end

