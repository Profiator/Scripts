-- LOGIC & TELEPORTATION
----------------------------------------
local TARGET_HEIGHT = 500000

RunService.Heartbeat:Connect(function()
    -- Logic for Instant LastZone Loop
    if getInstantLastZone() then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                -- Continually teleports to x500,000
                root.CFrame = CFrame.new(0, TARGET_HEIGHT, 0)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

task.spawn(function()
    -- Logic for Equip Best Loop
    while task.wait(1) do
        if getEquipBest() then
            pcall(function()
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local Remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("RemoteEvents")
                if Remotes then
                    local equipRemote = Remotes:FindFirstChild("EquipBest") or Remotes:FindFirstChild("PetAction")
                    if equipRemote then
                        equipRemote:FireServer("EquipBest")
                    end
                end
            end)
        end
    end
end)