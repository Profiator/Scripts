-- MEGA RAMP FOR SLIME
-- Original recovered logic with ONLY the last-zone target changed:
--   Checkpoint: 68 -> 92
--   Final CFrame: (-21, 3, 2101) -> (16.58, 4.00, 3304.53)
-- Everything else is kept in the same simple cycle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local oldGui = CoreGui:FindFirstChild("ToraScript")
if oldGui then
    oldGui:Destroy()
end

local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew",
    true
))()

local Window = Library:CreateWindow("MEGA RAMP FOR SLIME")

local function LastZone()
    while _G.LastZone do
        wait()

        -- ORIGINAL: move the player to the car spawn.
        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame =
            workspace.Progetto.CarSpawn.CFrame

        wait(1)

        -- ORIGINAL: scan workspace and use the object whose Name equals player Name.
        for _, car in pairs(workspace:GetChildren()) do
            if car.Name == game.Players.LocalPlayer.Name then
                -- ORIGINAL first position.
                car:SetPrimaryPartCFrame(workspace.Progetto.JumpCar.CFrame)
                wait(0.2)

                -- ONLY CHANGE #1: old script used Checkpoints["68"].
                -- x1,000,000 is Checkpoint 92.
                car:SetPrimaryPartCFrame(workspace.Progetto.Checkpoints["92"].CFrame)
                wait(0.2)

                -- ONLY CHANGE #2: final x1,000,000 coordinates supplied by user.
                car:SetPrimaryPartCFrame(CFrame.new(16.58, 4.00, 3304.53))
                wait(1)

                -- ORIGINAL reward clicks.
                for _ = 1, 10 do
                    game:GetService("ReplicatedStorage").Remotes.OpenBoxClick:FireServer()
                end
            end
        end
    end
end

local function Equip()
    while _G.Equip do
        game:GetService("ReplicatedStorage").Remotes.EquipBestInventory:FireServer()
        wait(2)
    end
end

Window:AddToggle({
    text = "Instant LastZone",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.LastZone = value
        print("LastZone: ", value)

        if value then
            spawn(LastZone)
        end
    end,
})

Window:AddToggle({
    text = "Equip Best",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.Equip = value
        print("Equip: ", value)

        if value then
            spawn(Equip)
        end
    end,
})

Window:AddLabel({
    text = "YouTube: Tora IsMe",
})

Library:Init()
