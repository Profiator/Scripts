
-- FIXED x1,000,000 FARM
-- Keeps the recovered original flow, but extends checkpoint progression:
-- JumpCar -> 69 -> 70 -> ... -> 92 -> final x1M coordinate
-- Also waits for the player's car instead of repeatedly resetting at CarSpawn.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Progetto = workspace:WaitForChild("Progetto")
local Checkpoints = Progetto:WaitForChild("Checkpoints")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local oldGui = CoreGui:FindFirstChild("ToraScript")
if oldGui then
    oldGui:Destroy()
end

local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew",
    true
))()

local Window = Library:CreateWindow("MEGA RAMP FOR SLIME")

local FINAL_CFRAME = CFrame.new(16.58, 4.00, 3304.53)
local FIRST_EXTRA_CHECKPOINT = 69
local LAST_CHECKPOINT = 92

-- Wait for the actual player vehicle. The old fixed wait(1) can miss it,
-- which causes the character to be sent to CarSpawn over and over.
local function waitForPlayerCar(timeout)
    local started = tick()

    repeat
        -- Original script checks root workspace children by exact player name.
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == LocalPlayer.Name and obj:IsA("Model") then
                return obj
            end
        end

        -- Fallback in case the game now places the vehicle inside a folder/model.
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == LocalPlayer.Name and obj:IsA("Model") then
                return obj
            end
        end

        task.wait(0.10)
    until not _G.LastZone or (tick() - started) >= timeout

    return nil
end

local function preparePrimaryPart(car)
    if car.PrimaryPart then
        return true
    end

    local preferred = car:FindFirstChild("VehicleSeat", true)
        or car:FindFirstChild("DriveSeat", true)
        or car:FindFirstChildWhichIsA("VehicleSeat", true)
        or car:FindFirstChildWhichIsA("Seat", true)
        or car:FindFirstChildWhichIsA("BasePart", true)

    if preferred and preferred:IsA("BasePart") then
        car.PrimaryPart = preferred
        return true
    end

    return false
end

local function moveCar(car, targetCFrame)
    if not car or not car.Parent then
        return false
    end

    if preparePrimaryPart(car) then
        local ok = pcall(function()
            car:SetPrimaryPartCFrame(targetCFrame)
        end)
        if ok then
            return true
        end
    end

    -- Fallback for models where SetPrimaryPartCFrame is unavailable/unstable.
    return pcall(function()
        car:PivotTo(targetCFrame)
    end)
end

local function LastZone()
    -- Prevent several workers being started by repeated toggle callbacks.
    if _G.__LastZoneWorker then
        return
    end
    _G.__LastZoneWorker = true

    while _G.LastZone do
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")

        if not root then
            root = character:WaitForChild("HumanoidRootPart", 5)
        end

        if not root then
            task.wait(0.5)
            continue
        end

        -- ORIGINAL: go to the car spawn once per farm cycle.
        root.CFrame = Progetto.CarSpawn.CFrame

        -- FIX: wait until the car really exists instead of blindly waiting 1 sec.
        local car = waitForPlayerCar(8)

        if not _G.LastZone then
            break
        end

        if not car then
            warn("[x1M] Player car was not found. Retrying...")
            task.wait(0.5)
            continue
        end

        -- ORIGINAL first car position.
        if not moveCar(car, Progetto.JumpCar.CFrame) then
            warn("[x1M] Could not move car to JumpCar")
            task.wait(0.5)
            continue
        end

        task.wait(0.2)

        -- Requested extension: continue the checkpoints in order, 69 through 92.
        local checkpointFailed = false

        for checkpointNumber = FIRST_EXTRA_CHECKPOINT, LAST_CHECKPOINT do
            if not _G.LastZone then
                break
            end

            local checkpoint = Checkpoints:FindFirstChild(tostring(checkpointNumber))

            if not checkpoint then
                warn("[x1M] Missing checkpoint: " .. tostring(checkpointNumber))
                checkpointFailed = true
                break
            end

            local checkpointCFrame

            if checkpoint:IsA("BasePart") then
                checkpointCFrame = checkpoint.CFrame
            elseif checkpoint:IsA("Model") then
                checkpointCFrame = checkpoint:GetPivot()
            else
                local part = checkpoint:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    checkpointCFrame = part.CFrame
                end
            end

            if not checkpointCFrame or not moveCar(car, checkpointCFrame) then
                warn("[x1M] Failed checkpoint: " .. tostring(checkpointNumber))
                checkpointFailed = true
                break
            end

            -- Give Touch/Checkpoint logic time to register each numbered checkpoint.
            task.wait(0.12)
        end

        if not _G.LastZone then
            break
        end

        if checkpointFailed then
            task.wait(0.5)
            continue
        end

        -- Same final move as original, changed only to the x1,000,000 coordinate.
        task.wait(0.2)
        moveCar(car, FINAL_CFRAME)
        task.wait(1)

        -- ORIGINAL reward clicks.
        for _ = 1, 10 do
            Remotes.OpenBoxClick:FireServer()
        end

        task.wait()
    end

    _G.__LastZoneWorker = false
end

local function Equip()
    if _G.__EquipWorker then
        return
    end
    _G.__EquipWorker = true

    while _G.Equip do
        Remotes.EquipBestInventory:FireServer()
        task.wait(2)
    end

    _G.__EquipWorker = false
end

Window:AddToggle({
    text = "Instant LastZone",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.LastZone = value
        print("LastZone: ", value)

        if value then
            task.spawn(LastZone)
        end
    end,
})

Window:AddToggle({
    text = "Equip Best",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.Equip = value
        print("Equip: ", value)

        if value then
            task.spawn(Equip)
        end
    end,
})

Window:AddLabel({
    text = "CP 69 -> 92 | Target x1,000,000",
})

Window:AddLabel({
    text = "YouTube: Tora IsMe",
})

Library:Init()
