local function getCharRoot(forPhysics)
    local char = LocalPlayer.Character
    if not char then return nil, "No Character" end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local vehicle = seat:FindFirstAncestorWhichIsA("Model")
        while vehicle and vehicle.Parent and vehicle.Parent:IsA("Model") and vehicle.Parent ~= Workspace do
            vehicle = vehicle.Parent
        end
        if vehicle then
            if forPhysics then return seat, "Vehicle" end
            return vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart") or seat, "Vehicle", vehicle
        end
        return seat, "Seat"
    end
    return char:FindFirstChild("HumanoidRootPart"), "Character"
end

local function teleportTo(pos, keepExact)
    local root, rootType, vehicleModel = getCharRoot(false)
    if root then
        local rot = root.CFrame.Rotation
        local targetCFrame = keepExact and CFrame.new(pos) * rot or CFrame.new(pos + Vector3.new(0, 3, 0)) * rot
        
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChild("Humanoid")
        if humanoid and humanoid.SeatPart then
            pcall(function() humanoid.Sit = true end)
        end
        
        if rootType == "Vehicle" and vehicleModel then
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    pcall(function() part.CanCollide = true end)
                end
            end
            vehicleModel:PivotTo(targetCFrame)
        else
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.CFrame = targetCFrame
        end
    end
end

-- Fast movement helper
local function safeMove(startPos, endPos, duration, forceVel)
    local root, rootType, vehicleModel = getCharRoot(false)
    if not root then return end
    
    local startTime = tick()
    local connection
    local finished = false
    
    local flatDir = Vector3.new(endPos.X - startPos.X, 0, endPos.Z - startPos.Z)
    local dir = flatDir.Magnitude > 0.001 and flatDir.Unit or Vector3.new(0, 0, 1)
    local calculatedVel = (endPos - startPos) / math.max(duration, 0.01)
    local moveVelocity = forceVel or calculatedVel
    
    connection = RunService.Heartbeat:Connect(function()
        if not isAutoFarmEnabled() then
            finished = true
            connection:Disconnect()
            return
        end
        
        local currentRoot, currentType, currentModel = getCharRoot(false)
        if not currentRoot then
            finished = true
            connection:Disconnect()
            return
        end

        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        local currentPos = startPos:Lerp(endPos, alpha)
        
        local cframe = CFrame.new(currentPos, currentPos + dir)
        
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChild("Humanoid")
        if humanoid and humanoid.SeatPart then
            pcall(function() humanoid.Sit = true end)
        end
        
        if currentType == "Vehicle" and currentModel then
            for _, part in ipairs(currentModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = moveVelocity
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    pcall(function() part.CanCollide = true end)
                end
            end
            currentModel:PivotTo(cframe)
        else
            currentRoot.CFrame = cframe
            currentRoot.AssemblyLinearVelocity = moveVelocity
            currentRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        if alpha >= 1 then
            finished = true
            connection:Disconnect()
        end
    end)
    
    while not finished and isAutoFarmEnabled() do
        task.wait(0.01)
    end
    if connection then connection:Disconnect() end
end

-- Aggressive Auto-Clicker & Open Button Executor for Finish
local function executeFinishClicker(maxSeconds)
    local delayVal = getClickDelay and getClickDelay() or 0
    local durationVal = getClickDuration and getClickDuration() or (maxSeconds or 2.0)
    local cpsVal = getCPS and getCPS() or 20
    local clickInterval = 1 / math.clamp(cpsVal, 1, 50)
    
    local function isClickerActive()
        return isAutoFarmEnabled() or isAutoClickerEnabled()
    end
    
    -- Задержка перед началом кликанья
    if delayVal > 0 then
        local delayStart = tick()
        while isClickerActive() and (tick() - delayStart) < delayVal do
            task.wait(0.05)
        end
    end
    
    local clickStart = tick()
    local lastCustomClick = 0
    local camera = Workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(1000, 800)
    local centerX = vp.X / 2
    local centerY = vp.Y / 2
    
    while isClickerActive() and (tick() - clickStart) < durationVal do
        local now = tick()
        
        -- 1. Выполнение клика в выбранную пользователем кастомную точку с заданным CPS
        if customClickX and customClickY then
            if (now - lastCustomClick) >= clickInterval then
                lastCustomClick = now
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(customClickX, customClickY, 0, true, game, 1)
                    task.wait(0.01)
                    VirtualInputManager:SendMouseButtonEvent(customClickX, customClickY, 0, false, game, 1)
                    if VirtualUser then
                        VirtualUser:Button1Down(Vector2.new(customClickX, customClickY), camera.CFrame)
                        VirtualUser:Button1Up(Vector2.new(customClickX, customClickY), camera.CFrame)
                    end
                end)
            end
        end
        
        -- 2. Нажатие активных GUI кнопок ("Открыть", "Claim", "Case", etc)
        local btnToClick = nil
        pcall(function()
            for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("GuiObject") and obj.Visible then
                    local txt = ""
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        txt = (obj.Text or ""):lower()
                    end
                    local name = obj.Name:lower()
                    
                    if txt:find("открыть") or txt:find("open") or txt:find("claim") or txt:find("забрать") or txt:find("spin") or txt:find("крутить") or txt:find("skip") or txt:find("пропустить") or txt:find("кейсы") or txt:find("case") or txt:find("box") or txt:find("chest") or txt:find("нажмите") or txt:find("click") or txt:find("next") or txt:find("далее") or txt:find("x") or txt:find("х") or txt:find("close") or txt:find("закрыть") or name:find("open") or name:find("claim") or name:find("case") or name:find("close") or name:find("x") then
                        local isVis = true
                        local curr = obj
                        while curr and curr:IsA("GuiObject") do
                            if not curr.Visible then isVis = false break end
                            curr = curr.Parent
                        end
                        if isVis then
                            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                btnToClick = obj
                                break
                            else
                                local p = obj.Parent
                                while p and p:IsA("GuiObject") do
                                    if p:IsA("TextButton") or p:IsA("ImageButton") then
                                        btnToClick = p
                                        break
                                    end
                                    p = p.Parent
                                end
                                if btnToClick then break end
                            end
                        end
                    end
                end
            end
        end)
        
        -- 3. Trigger nearby ProximityPrompts and Multipliers
        pcall(function()
            local root = getCharRoot(false)
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                elseif root and prompt:IsA("BasePart") then
                    local pName = prompt.Name:lower()
                    if pName:find("x%d") or pName:find("multiplier") then
                        if (prompt.Position - root.Position).Magnitude < 150 then
                            if firetouchinterest then
                                firetouchinterest(root, prompt, 0)
                                task.wait(0.01)
                                firetouchinterest(root, prompt, 1)
                            end
                        end
                    end
                end
            end
        end)
        
        -- 4. Click detected button directly
        if btnToClick then
            pcall(function()
                if getconnections and btnToClick:IsA("GuiButton") then
                    for _, conn in ipairs(getconnections(btnToClick.MouseButton1Down)) do conn:Fire() end
                    for _, conn in ipairs(getconnections(btnToClick.MouseButton1Click)) do conn:Fire() end
                    for _, conn in ipairs(getconnections(btnToClick.Activated)) do conn:Fire() end
                end
                local pos = btnToClick.AbsolutePosition
                local size = btnToClick.AbsoluteSize
                local center = pos + (size / 2)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, true, game, 1)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, false, game, 1)
            end)
        end
        
        -- 5. Если кастомная точка не выбрана, кликаем в центр экрана
        if not (customClickX and customClickY) then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY + 36, 0, true, game, 1)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY + 36, 0, false, game, 1)
            end)
        end
        
        -- 6. Send Keyboard triggers (E, Space)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        
        task.wait(0.02)
    end
end

