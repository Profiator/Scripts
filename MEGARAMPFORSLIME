-- Функция обновления лога
local function updateLog()
    local text = table.concat(logLines, "\n")
    logTextObj.Text = text
end

local function addLogLine(line)
    table.insert(logLines, line)
    if #logLines > 30 then table.remove(logLines, 1) end
    updateLog()
end

-- Функция получения X
local function getCurrentX()
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local txt = child.Text or ""
                    local num = tonumber(txt:match("(%d+)"))
                    if num and num > 100 then return num end
                end
            end
        end
    end
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local xStat = stats:FindFirstChild("X")
        if xStat and xStat:IsA("IntValue") then return xStat.Value end
    end
    return 0
end

-- Обработка кликов по кнопкам
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local mousePos = UserInputService:GetMouseLocation()

    -- Проверка попадания в кнопку Старт
    if mousePos.X >= btnStart.Position.X and mousePos.X <= btnStart.Position.X + btnStart.Size.X and
       mousePos.Y >= btnStart.Position.Y and mousePos.Y <= btnStart.Position.Y + btnStart.Size.Y then
        if collecting then
            addLogLine("Уже собираем.")
            return
        end
        collecting = true
        analysisData = {positions={}, zones={}, xChanges={}, keyLogs={}, startTime=os.time(), endTime=nil, finalX=0}
        lastX = getCurrentX()
        addLogLine("▶ АНАЛИЗ ЗАПУЩЕН. Начальный X: " .. lastX)
        statusText.Text = "Идёт сбор..."
        -- Подписки
        connections.heartbeat = RunService.Heartbeat:Connect(function(dt)
            if not collecting then return end
            timer = timer + dt
            if timer >= 0.1 then
                timer = 0
                if not RootPart then return end
                local pos = RootPart.Position
                local x = getCurrentX()
                table.insert(analysisData.positions, {x=pos.X, y=pos.Y, z=pos.Z, time=os.time(), xVal=x})
                if x ~= lastX then
                    table.insert(analysisData.xChanges, {from=lastX, to=x, pos={x=pos.X, y=pos.Y, z=pos.Z}, time=os.time()})
                    addLogLine("X: " .. lastX .. " → " .. x)
                    lastX = x
                end
                -- Поиск зон
                for _, part in ipairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local dist = (part.Position - RootPart.Position).Magnitude
                        if dist < 15 then
                            local name = part.Name:lower()
                            if name:find("zone") or name:find("trigger") or name:find("checkpoint") or name:find("ramp") then
                                local key = part.Name .. "_" .. tostring(part.Position)
                                if not analysisData.zones[key] then
                                    analysisData.zones[key] = {name = part.Name, pos = {x=part.Position.X, y=part.Position.Y, z=part.Position.Z}}
                                    addLogLine("Зона: " .. part.Name .. " (" .. string.format("%.1f", part.Position.X) .. ", " .. string.format("%.1f", part.Position.Y) .. ", " .. string.format("%.1f", part.Position.Z) .. ")")
                                end
                            end
                        end
                    end
                end
            end
        end)
        connections.keys = UserInputService.InputBegan:Connect(function(input, gp)
            if not collecting then return end
            if gp then return end
            local key = input.KeyCode.Name
            table.insert(analysisData.keyLogs, {key=key, time=os.time()})
            addLogLine("Клавиша: " .. key)
        end)
        return
    end

    -- Кнопка Стоп
    if mousePos.X >= btnStop.Position.X and mousePos.X <= btnStop.Position.X + btnStop.Size.X and
       mousePos.Y >= btnStop.Position.Y and mousePos.Y <= btnStop.Position.Y + btnStop.Size.Y then
        if not collecting then
            addLogLine("Анализ не запущен.")
            return
        end
        collecting = false
        analysisData.endTime = os.time()
        analysisData.finalX = getCurrentX()
        if connections.heartbeat then connections.heartbeat:Disconnect() end
        if connections.keys then connections.keys:Disconnect() end
        addLogLine("⏹ АНАЛИЗ ОСТАНОВЛЕН. Финальный X: " .. analysisData.finalX)
        addLogLine("Найдено зон: " .. #analysisData.zones .. ", изменений X: " .. #analysisData.xChanges)
        statusText.Text = "Остановлен. Нажми КОПИРОВАТЬ."
        return
    end

    -- Кнопка Копировать
    if mousePos.X >= btnCopy.Position.X and mousePos.X <= btnCopy.Position.X + btnCopy.Size.X and
       mousePos.Y >= btnCopy.Position.Y and mousePos.Y <= btnCopy.Position.Y + btnCopy.Size.Y then
        if not analysisData.startTime then
            addLogLine("Нет данных. Сначала запустите анализ.")
            return
        end
        local report = "=== АНАЛИЗ ИГРЫ ===\n"
        report = report .. "Начало: " .. os.date("%H:%M:%S", analysisData.startTime) .. "\n"
        if analysisData.endTime then
            report = report .. "Конец: " .. os.date("%H:%M:%S", analysisData.endTime) .. "\n"
            report = report .. "Длительность: " .. (analysisData.endTime - analysisData.startTime) .. " сек\n"
        end
        report = report .. "Финальный X: " .. analysisData.finalX .. "\n"
        report = report .. "Найдено зон: " .. #analysisData.zones .. "\n"
        report = report .. "Изменений X: " .. #analysisData.xChanges .. "\n"
        report = report .. "Всего точек: " .. #analysisData.positions .. "\n"
        report = report .. "Нажатий клавиш: " .. #analysisData.keyLogs .. "\n\n"
        report = report .. "СПИСОК ЗОН:\n"
        for _, zone in pairs(analysisData.zones) do
            report = report .. "  " .. zone.name .. " -> (" .. string.format("%.1f", zone.pos.x) .. ", " .. string.format("%.1f", zone.pos.y) .. ", " .. string.format("%.1f", zone.pos.z) .. ")\n"
        end
        report = report .. "=== КОНЕЦ ==="
        addLogLine("📋 Отчёт сгенерирован.")
        -- Копирование
        local success, err = pcall(function()
            setclipboard(report)
        end)
        if success then
            addLogLine("✅ Отчёт скопирован в буфер обмена.")
            statusText.Text = "Скопировано!"
        else
            addLogLine("❌ Ошибка копирования: " .. tostring(err))
            addLogLine("Скопируйте текст ниже вручную:")
            addLogLine(report)
            statusText.Text = "Копируй вручную."
        end
        return
    end
end)

