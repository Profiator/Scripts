                                                else
                                                    prompt:InputHoldBegin()
                                                    task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration + 0.1 or 0.3)
                                                    prompt:InputHoldEnd()
                                                end
                                            end
                                        end
                                    end
                                end
                            end)
                            if repeats > 1 then task.wait(0.5) end
                        end
                        
                        playIndex = playIndex + 1
                        if playIndex > #routePoints then playIndex = 1 end
                        playStuckTimer = 0
                        farmInteracting = false
                    end)
                else
                    humanoid:MoveTo(targetPos)
                    if targetPos.Y - root.Position.Y > 2 then
                        humanoid.Jump = true
                    end
                    playStuckTimer = playStuckTimer + dt
                    if playStuckTimer > 3 then
                        humanoid.Jump = true
                        playStuckTimer = 0
                    end
                end
            end
        end
    else
        playIndex = 1
        playStuckTimer = 0
        farmInteracting = false
    end
