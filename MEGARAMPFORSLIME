-- 1. Перехватываем стандартные функции
local oldPrint = print
local oldWarn = warn
local oldLoadstring = loadstring
local oldHttpGet = game.HttpGet

-- Буфер для сбора всего вывода
local outputBuffer = {}
local function addToBuffer(str)
    table.insert(outputBuffer, str)
end

-- Переопределяем print
print = function(...)
    local args = {...}
    for _, v in ipairs(args) do
        local str = tostring(v)
        addToBuffer("[PRINT] " .. str)
        oldPrint("[DECODED] " .. str)
    end
end

-- Переопределяем warn
warn = function(...)
    local args = {...}
    for _, v in ipairs(args) do
        local str = tostring(v)
        addToBuffer("[WARN] " .. str)
        oldWarn("[DECODED WARN] " .. str)
    end
end

-- Перехватываем loadstring
loadstring = function(s, chunkname)
    addToBuffer("[LOADSTRING] Блок кода:\n" .. s)
    oldPrint("[LOADSTRING] Блок кода:\n" .. s)
    return oldLoadstring(s, chunkname)
end

-- Перехватываем game:HttpGet
game.HttpGet = function(self, url, ...)
    addToBuffer("[HTTPGET] Запрос: " .. url)
    oldPrint("[HTTPGET] Запрос: " .. url)
    local content = oldHttpGet(self, url, ...)
    addToBuffer("[HTTPGET] Получено байт: " .. #content)
    oldPrint("[HTTPGET] Получено байт: " .. #content)
    return content
end

-- 2. Загружаем целевой скрипт
local targetUrl = "https://raw.githubusercontent.com/gumanba/Scripts/main/MEGARAMPFORSLIME"
local scriptCode = game:HttpGet(targetUrl)

addToBuffer("=== ОРИГИНАЛЬНЫЙ КОД (сырой) ===")
addToBuffer(scriptCode)
oldPrint("=== ОРИГИНАЛЬНЫЙ КОД (сырой) ===")
oldPrint(scriptCode)

-- 3. Выполняем скрипт с перехватом
addToBuffer("=== ЗАПУСК СКРИПТА ===")
oldPrint("=== ЗАПУСК СКРИПТА ===")

local func, err = loadstring(scriptCode)
if func then
    local success, result = pcall(func)
    if success then
        addToBuffer("=== ВЫПОЛНЕНИЕ УСПЕШНО ===")
        oldPrint("=== ВЫПОЛНЕНИЕ УСПЕШНО ===")
        if type(result) == "function" then
            addToBuffer("Получена функция: " .. tostring(result))
            oldPrint("Получена функция: " .. tostring(result))
            local success2, res2 = pcall(result)
            if success2 then
                addToBuffer("Результат вызова функции: " .. tostring(res2))
                oldPrint("Результат вызова функции: " .. tostring(res2))
            else
                addToBuffer("Ошибка вызова функции: " .. tostring(res2))
                oldPrint("Ошибка вызова функции: " .. tostring(res2))
            end
        else
            addToBuffer("Результат: " .. tostring(result))
            oldPrint("Результат: " .. tostring(result))
        end
    else
        addToBuffer("Ошибка выполнения: " .. tostring(result))
        oldPrint("Ошибка выполнения: " .. tostring(result))
    end
else
    addToBuffer("Ошибка загрузки: " .. tostring(err))
    oldPrint("Ошибка загрузки: " .. tostring(err))
end

addToBuffer("=== ВЫПОЛНЕНИЕ ЗАВЕРШЕНО ===")
oldPrint("=== ВЫПОЛНЕНИЕ ЗАВЕРШЕНО ===")

-- 4. Собираем итоговый текст
