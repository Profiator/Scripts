local isRecording, setRecording = createToggle("Запись маршрута", FarmTab)
local isPlaying, setPlaying = createToggle("Воспроизведение маршрута", FarmTab)
local routePoints = {}

local clearRouteBtn = Instance.new("TextButton")
clearRouteBtn.Size = UDim2.new(1, 0, 0, 30)
clearRouteBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
clearRouteBtn.Text = "Очистить маршрут (Точек: 0)"
