local isFarmPlaying = false
local flying = false
local flyActiveTime = 0
local function handleFlyAndSpeed(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    local root = getCharRoot(true) -- Supports vehicles
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not root then return end
    
    if isFlyEnabled() and root ~= hrp then
        -- We are flying in a vehicle, disable jumping so space doesn't make us exit
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    else
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    end

    local currentSpeedActive = isCustomSpeed() or speedHoldActive or isFarmPlaying

    -- Custom Speed Logic (Works for Walk & Vehicles)
    if currentSpeedActive and not isFlyEnabled() then
        if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            -- Vehicle Speed bypass
            local seat = humanoid.SeatPart
            if seat.Throttle ~= 0 then
                local speedStr = isFarmPlaying and 300 or getSpeed()
                local moveDir = root.CFrame.lookVector * seat.Throttle
                root.AssemblyLinearVelocity = Vector3.new(
                    moveDir.X * speedStr,
                    root.AssemblyLinearVelocity.Y,
                    moveDir.Z * speedStr
                )
            end
        else
            -- Character Speed
            if humanoid.MoveDirection.Magnitude > 0 then
                local speedStr = isFarmPlaying and 300 or getSpeed()
                local speedDiff = speedStr - humanoid.WalkSpeed
                if speedDiff > 0 then
                    local displacement = humanoid.MoveDirection * (speedDiff * deltaTime)
                    if hrp then
                        hrp.CFrame = hrp.CFrame + displacement
                    end
                end
            end
        end
    end

    -- Fly Logic
    if isFlyEnabled() then
        flyActiveTime = flyActiveTime + deltaTime
        if flyActiveTime >= 3.5 then
            setFlyEnabled(false)
            flyActiveTime = 0
            flying = false
            return
        end

        if not flying then
            flying = true
        end
        
        -- Move Fake Ground below player safely to bypass AntiFly without boosting up
        if flyPlatform then
            local targetPos = hrp and hrp.Position or root.Position
            if root ~= hrp then
                targetPos = root.Position + Vector3.new(0, -6, 0)
            else
                targetPos = targetPos + Vector3.new(0, -3.1, 0)
            end
            flyPlatform.CFrame = CFrame.new(targetPos)
        end
        
        local moveDir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.lookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.lookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.rightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.rightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        local currentSpeed = isCustomSpeed() and getSpeed() or 50
        
        if root == hrp then
            -- Character Fly
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
                root.CFrame = root.CFrame + (moveDir * currentSpeed * deltaTime)
            end
        else
            -- Vehicle Fly
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
                root.AssemblyLinearVelocity = moveDir * currentSpeed
                
                -- Level out the vehicle but face camera horizontally
                local lookFlat = Vector3.new(Camera.CFrame.lookVector.X, 0, Camera.CFrame.lookVector.Z).Unit
                if lookFlat.Magnitude > 0 then
                    local targetCFrame = CFrame.lookAt(root.Position, root.Position + lookFlat)
                    root.CFrame = root.CFrame:Lerp(targetCFrame, 0.1)
                end
            else
                root.AssemblyLinearVelocity = Vector3.zero
            end
            root.AssemblyAngularVelocity = Vector3.zero
        end
    else
        flyActiveTime = 0
        if flying then
            flying = false
        end
        -- Hide fake ground when not flying
        if flyPlatform then
            flyPlatform.CFrame = CFrame.new(0, -9999, 0)
        end
    end
end
