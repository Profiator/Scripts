-- Переменные сбора
local collecting = false
local data = {
    positions = {},       -- все точки траектории
    objects = {},         -- все уникальные объекты (части) рядом с игроком
    xChanges = {},        -- изменения X
    keyLogs = {},         -- нажатия клавиш
    startTime = nil,
    endTime = nil,
    finalX = 0,
}
local lastX = 0
local timer = 0
local connections = {}
local logLines = {"▶ Нажми СТАРТ, поезжай, затем СТОП."}
local maxLogLines = 50

local function addLogLine(line)
    table.insert(logLines, line)
    if #logLines > maxLogLines then table.remove(logLines, 1) end
    logTextObj.Text = table.concat(logLines, "\n")
end

local function getCurrentX()
    -- Из GUI
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local txt = child.Text or ""
                    local num = tonumber(txt:match("(%d+)"))
                    if num and num > 100 then return num end
                end
            end
        end
    end
    -- Из leaderstats
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local xStat = stats:FindFirstChild("X")
        if xStat and xStat:IsA("IntValue") then return xStat.Value end
    end
    return 0
end

-- Функция поиска всех объектов в радиусе (запоминаем уникальные)
local function scanNearbyObjects()
    if not RootPart then return end
    local pos = RootPart.Position
    local radius = 50 -- увеличенный радиус
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local dist = (obj.Position - pos).Magnitude
            if dist < radius then
                local key = obj.Name .. "_" .. tostring(obj.Position)
                if not data.objects[key] then
                    data.objects[key] = {
                        name = obj.Name,
                        className = obj.ClassName,
                        position = { x = obj.Position.X, y = obj.Position.Y, z = obj.Position.Z },
                        firstSeen = os.time()
                    }
                    -- Выводим в лог только первые 10 объектов, чтобы не забивать
                    if #data.objects <= 10 then
                        addLogLine("Объект: " .. obj.Name .. " (" .. string.format("%.1f", obj.Position.X) .. ", " .. string.format("%.1f", obj.Position.Y) .. ", " .. string.format("%.1f", obj.Position.Z) .. ")")
                    end
                end
            end
        end
    end
end

-- Сбор данных (запускается по кнопке)
local function startCollection()
    if collecting then return end
    collecting = true
    data = { positions={}, objects={}, xChanges={}, keyLogs={}, startTime=os.time(), endTime=nil, finalX=0 }
    lastX = getCurrentX()
    addLogLine("▶ АНАЛИЗ ЗАПУЩЕН. Начальный X: " .. lastX)
    statusText.Text = "Сбор..."

    connections.heartbeat = RunService.Heartbeat:Connect(function(dt)
        if not collecting then return end
        timer = timer + dt
        if timer >= 0.05 then -- каждые 0.05 сек
            timer = 0
            if not RootPart then return end
            local pos = RootPart.Position
            local x = getCurrentX()
            -- Запись позиции
            table.insert(data.positions, { x=pos.X, y=pos.Y, z=pos.Z, time=os.time(), xVal=x })
            -- Проверка изменения X
            if x ~= lastX then
                table.insert(data.xChanges, { from=lastX, to=x, pos={ x=pos.X, y=pos.Y, z=pos.Z }, time=os.time() })
                addLogLine("X: " .. lastX .. " → " .. x)
                lastX = x
            end
            -- Сканирование объектов рядом
            scanNearbyObjects()
        end
    end)

    connections.keys = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not collecting then return end
        if gameProcessed then return end
        local key = input.KeyCode.Name
        table.insert(data.keyLogs, { key=key, time=os.time() })
        -- Выводим только если это не повторяющиеся W/A/S/D (для краткости)
        if key ~= "W" and key ~= "A" and key ~= "S" and key ~= "D" then
            addLogLine("Клавиша: " .. key)
        end
    end)
end

local function stopCollection()
    if not collecting then return end
    collecting = false
    data.endTime = os.time()
    data.finalX = getCurrentX()
    if connections.heartbeat then connections.heartbeat:Disconnect() end
    if connections.keys then connections.keys:Disconnect() end
    addLogLine("⏹ АНАЛИЗ ОСТАНОВЛЕН. Финальный X: " .. data.finalX)
    addLogLine("Найдено объектов: " .. #data.objects)
    addLogLine("Всего точек: " .. #data.positions)
    statusText.Text = "Остановлен. Нажми КОПИРОВАТЬ."
end

-- Генерация отчёта
local function generateReport()
    if not data.startTime then return nil end
    local report = "=== РАСШИРЕННЫЙ АНАЛИЗ ИГРЫ ===\n"
    report = report .. "Начало: " .. os.date("%H:%M:%S", data.startTime) .. "\n"
    if data.endTime then
        report = report .. "Конец: " .. os.date("%H:%M:%S", data.endTime) .. "\n"
        report = report .. "Длительность: " .. (data.endTime - data.startTime) .. " сек\n"
    end
    report = report .. "Финальный X: " .. data.finalX .. "\n"
    report = report .. "Всего точек траектории: " .. #data.positions .. "\n"
    report = report .. "Всего изменений X: " .. #data.xChanges .. "\n"
    report = report .. "Всего уникальных объектов рядом: " .. #data.objects .. "\n\n"

    report = report .. "=== СПИСОК ОБЪЕКТОВ (координаты) ===\n"
    for _, obj in pairs(data.objects) do
        report = report .. "  " .. obj.name .. " (" .. obj.className .. ") -> (" 
        .. string.format("%.1f", obj.position.x) .. ", " 
        .. string.format("%.1f", obj.position.y) .. ", " 
        .. string.format("%.1f", obj.position.z) .. ")\n"
    end

    -- Добавим несколько точек траектории для примера (каждую 10-ю)
    report = report .. "\n=== ПРИМЕРНЫЕ ТОЧКИ ТРАЕКТОРИИ (каждая 10-я) ===\n"
    for i = 1, #data.positions, 10 do
        local p = data.positions[i]
        report = report .. string.format("  (%.1f, %.1f, %.1f)  X=%d\n", p.x, p.y, p.z, p.xVal or 0)
    end

    report = report .. "=== КОНЕЦ ==="
    return report
end

-- Обработка кликов
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local mousePos = UserInputService:GetMouseLocation()

    -- Кнопка Старт
    if mousePos.X >= btnStart.Position.X and mousePos.X <= btnStart.Position.X + btnStart.Size.X and
       mousePos.Y >= btnStart.Position.Y and mousePos.Y <= btnStart.Position.Y + btnStart.Size.Y then
        startCollection()
        return
    end

    -- Кнопка Стоп
    if mousePos.X >= btnStop.Position.X and mousePos.X <= btnStop.Position.X + btnStop.Size.X and
       mousePos.Y >= btnStop.Position.Y and mousePos.Y <= btnStop.Position.Y + btnStop.Size.Y then
        stopCollection()
        return
    end

    -- Кнопка Копировать
    if mousePos.X >= btnCopy.Position.X and mousePos.X <= btnCopy.Position.X + btnCopy.Size.X and
       mousePos.Y >= btnCopy.Position.Y and mousePos.Y <= btnCopy.Position.Y + btnCopy.Size.Y then
        local report = generateReport()
        if not report then
            addLogLine("Нет данных. Запустите анализ.")
            return
        end
        addLogLine("📋 Отчёт сгенерирован. Копирую...")
        local success, err = pcall(function()
            setclipboard(report)
        end)
        if success then
            addLogLine("✅ Отчёт скопирован в буфер обмена.")
            statusText.Text = "Скопировано!"
        else
            addLogLine("❌ Ошибка копирования: " .. tostring(err))
            addLogLine("Скопируйте текст ниже:")
            addLogLine(report)
            statusText.Text = "Копируй вручную."
        end
        return
    end
end)

