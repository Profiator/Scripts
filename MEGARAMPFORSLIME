local function getCharRoot(forPhysics)
    local char = LocalPlayer.Character
    if not char then return nil, "No Character" end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local vehicle = seat:FindFirstAncestorWhichIsA("Model")
        while vehicle and vehicle.Parent and vehicle.Parent:IsA("Model") and vehicle.Parent ~= Workspace do
            vehicle = vehicle.Parent
        end
        if vehicle then
            if forPhysics then return seat, "Vehicle" end
            return vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart") or seat, "Vehicle", vehicle
        end
        return seat, "Seat"
    end
    return char:FindFirstChild("HumanoidRootPart"), "Character"
end

local function teleportTo(pos, keepExact)
    local root, rootType, vehicleModel = getCharRoot(false)
    if root then
        local rot = root.CFrame.Rotation
        local targetCFrame = keepExact and CFrame.new(pos) * rot or CFrame.new(pos + Vector3.new(0, 3, 0)) * rot
        
        if rootType == "Vehicle" and vehicleModel then
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            vehicleModel:PivotTo(targetCFrame)
        else
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.CFrame = targetCFrame
        end
    end
end

-- Fast movement helper
local function safeMove(startPos, endPos, duration, forceVel)
    local root, rootType, vehicleModel = getCharRoot(false)
    if not root then return end
    
    local startTime = tick()
    local connection
    local finished = false
    
    local flatDir = Vector3.new(endPos.X - startPos.X, 0, endPos.Z - startPos.Z)
    local dir = flatDir.Magnitude > 0.001 and flatDir.Unit or Vector3.new(0, 0, 1)
    local calculatedVel = (endPos - startPos) / math.max(duration, 0.01)
    local moveVelocity = forceVel or calculatedVel
    
    connection = RunService.Heartbeat:Connect(function()
        if not isAutoFarmEnabled() then
            finished = true
            connection:Disconnect()
            return
        end
        
        local currentRoot, currentType, currentModel = getCharRoot(false)
        if not currentRoot then
            finished = true
            connection:Disconnect()
            return
        end

        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        local currentPos = startPos:Lerp(endPos, alpha)
        
        local cframe = CFrame.new(currentPos, currentPos + dir)
        if currentType == "Vehicle" and currentModel then
            for _, part in ipairs(currentModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = moveVelocity
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            currentModel:PivotTo(cframe)
        else
            currentRoot.CFrame = cframe
            currentRoot.AssemblyLinearVelocity = moveVelocity
            currentRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        if alpha >= 1 then
            finished = true
            connection:Disconnect()
        end
    end)
    
    while not finished and isAutoFarmEnabled() do
        task.wait(0.01)
    end
    if connection then connection:Disconnect() end
end

-- Aggressive Auto-Clicker & Open Button Executor for Finish
local function executeFinishClicker(maxSeconds)
    local startT = tick()
    local camera = Workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(1000, 800)
    local centerX = vp.X / 2
    local centerY = vp.Y / 2
    
    while isAutoFarmEnabled() and (tick() - startT) < (maxSeconds or 5.0) do
        local btnToClick = nil
        
        -- 1. Search for active "Открыть" / "Open" / "Claim" / "Spin" / "Case" buttons
        pcall(function()
            for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("GuiObject") and obj.Visible then
                    local txt = ""
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        txt = (obj.Text or ""):lower()
                    end
                    local name = obj.Name:lower()
                    
                    if txt:find("открыть") or txt:find("open") or txt:find("claim") or txt:find("забрать") or txt:find("spin") or txt:find("крутить") or txt:find("skip") or txt:find("пропустить") or txt:find("кейсы") or txt:find("case") or txt:find("box") or txt:find("chest") or txt:find("нажмите") or txt:find("click") or txt:find("next") or txt:find("далее") or name:find("open") or name:find("claim") or name:find("case") then
                        local isVis = true
                        local curr = obj
                        while curr and curr:IsA("GuiObject") do
                            if not curr.Visible then isVis = false break end
                            curr = curr.Parent
                        end
                        if isVis then
                            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                btnToClick = obj
                                break
                            else
                                local p = obj.Parent
                                while p and p:IsA("GuiObject") do
                                    if p:IsA("TextButton") or p:IsA("ImageButton") then
                                        btnToClick = p
                                        break
                                    end
                                    p = p.Parent
                                end
                                if btnToClick then break end
                            end
                        end
                    end
                end
            end
        end)
        
        -- 2. Trigger nearby ProximityPrompts
        pcall(function()
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end)
        
        -- 3. Click detected button directly
        if btnToClick then
            pcall(function()
                if getconnections and btnToClick:IsA("GuiButton") then
                    for _, conn in ipairs(getconnections(btnToClick.MouseButton1Down)) do conn:Fire() end
                    for _, conn in ipairs(getconnections(btnToClick.MouseButton1Click)) do conn:Fire() end
                    for _, conn in ipairs(getconnections(btnToClick.Activated)) do conn:Fire() end
                end
                local pos = btnToClick.AbsolutePosition
                local size = btnToClick.AbsoluteSize
                local center = pos + (size / 2)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, true, game, 1)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, false, game, 1)
            end)
        end
        
        -- 4. Screen Center Auto-Clicker (taps screen center to speed up chest/case animation)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY + 36, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY + 36, 0, false, game, 1)
            if VirtualUser then
                VirtualUser:Button1Down(Vector2.new(centerX, centerY), camera.CFrame)
                VirtualUser:Button1Up(Vector2.new(centerX, centerY), camera.CFrame)
            end
        end)
        
        -- 5. Send Keyboard triggers (E, Space, Return)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        
        task.wait(0.05)
    end
end

-- Main Auto Farm Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if isAutoFarmEnabled() then
            local carPos = Vector3.new(0, 124, -1537)
            local jumpPos = Vector3.new(-9, 111, -1173)
            local flyPos = Vector3.new(2, 284, -363)
            local endPos = Vector3.new(8, 3, 2803)
            
            if carPos and endPos then
                if isAutoFarmEnabled() then
                    teleportTo(carPos)
                    task.wait(0.2)
                    local waitVehicleTime = tick()
                    while isAutoFarmEnabled() and (tick() - waitVehicleTime) < 0.8 do
                        local r, rType = getCharRoot(false)
                        if rType == "Vehicle" then break end
                        task.wait(0.05)
                    end
                end
                
                if isAutoFarmEnabled() then
                    local root = getCharRoot(false)
                    if root then
                        -- Drive off the ramp
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                        local startTime = tick()
                        
                        while isAutoFarmEnabled() and (tick() - startTime) < 3 do
                            root = getCharRoot(false)
                            if not root then break end
                            if root.Position.Z >= jumpPos.Z then
                                break
                            end
                            task.wait()
                        end
                        
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                        
                        if isAutoFarmEnabled() then
                            root = getCharRoot(false)
                            local flyStart = root and root.Position or jumpPos
                            
                            local flyHeight = 284
                            local hoverStart = Vector3.new(flyStart.X, flyHeight, flyStart.Z)
                            local hoverMid = Vector3.new(flyPos.X, flyHeight, flyPos.Z)
                            local hoverEnd = Vector3.new(endPos.X, flyHeight, endPos.Z)
                            
                            -- 1. Быстрый подъем на высоту полета (0.4 сек)
                            safeMove(flyStart, hoverStart, 0.4)
                            
                            -- 2. Плавный полет вперед для сбора всех X-множителей
                            if isAutoFarmEnabled() then
                                safeMove(hoverStart, hoverMid, 2.0)
                            end
                            if isAutoFarmEnabled() then
                                safeMove(hoverMid, hoverEnd, 2.0)
                            end
                            
                            -- 3. Быстрый спуск прямо на финиш (0.4 сек)
                            if isAutoFarmEnabled() then
                                safeMove(hoverEnd, endPos, 0.4)
                                teleportTo(endPos, true)
                            end
                            
                            -- Run finish clicker to rapidly trigger open buttons and skip case animations
                            if isAutoFarmEnabled() then
                                executeFinishClicker(3.5)
                                task.wait(0.3)
                            end
                        end
                    end
                end
            end
        end
    end
end)


-- MOVEMENT & SPEED
createLabel(_t("Speed"))
local isCustomSpeed = createToggle(_t("CustomSpeed"))
local getSpeed = createSlider(_t("SpeedSlider"), 16, 1000, 100)
local isFlyEnabled = createToggle(_t("Fly"))

local wasWalkSpeedChanged = false
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            if isCustomSpeed() and not isFlyEnabled() then
                humanoid.WalkSpeed = getSpeed()
                wasWalkSpeedChanged = true
                if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
                    humanoid.SeatPart.MaxSpeed = getSpeed()
                end
            elseif wasWalkSpeedChanged then
                humanoid.WalkSpeed = 16
                wasWalkSpeedChanged = false
                if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
                    humanoid.SeatPart.MaxSpeed = 50
                end
            end
        end
    end
end)

local flying = false
local flyBV, flyBG
local function startFly(root)
    if flying then return end
    flying = true
    
    flyBG = Instance.new("BodyGyro")
    flyBG.P = 9e5
    flyBG.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.cframe = root.CFrame
    flyBG.Parent = root
    
    flyBV = Instance.new("BodyVelocity")
    flyBV.velocity = Vector3.new(0, 0, 0)
    flyBV.maxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = root
end

local function stopFly()
    if not flying then return end
    flying = false
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
end

RunService.RenderStepped:Connect(function()
    if isFlyEnabled() then
        local root = getCharRoot(true)
        if root then
            if not flying or (flyBG and flyBG.Parent ~= root) then
                stopFly()
                startFly(root)
            end
            if flying and flyBG and flyBV then
                local camera = Workspace.CurrentCamera
                flyBG.cframe = CFrame.new(camera.CFrame.p, camera.CFrame.p + camera.CFrame.lookVector)
                
                local moveDir = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                
                local currentSpeed = isCustomSpeed() and getSpeed() or 50
                
                if root.Name ~= "HumanoidRootPart" then
                    flyBG.P = 9e6
                    flyBG.D = 1000
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                
                flyBV.velocity = moveDir.Magnitude > 0 and moveDir.Unit * currentSpeed or Vector3.new(0, 0, 0)
            end
        end
    else
        stopFly()
    end
end)

