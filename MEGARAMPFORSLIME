-- TELEPORTS
local function teleportTo(targetPos, keepVehicle)
    local root = getCharRoot(keepVehicle)
    if not root then return end
    
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    
    local model = root:FindFirstAncestorWhichIsA("Model") or root.Parent
    local startPos = root.Position
    local dist = (startPos - targetPos).Magnitude
    
    local finalPos = targetPos + Vector3.new(0, 5, 0)
    
    -- If very close, just jump there instantly
    if dist < 50 then
        model:PivotTo(CFrame.new(finalPos))
        if humanoid then pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        return
    end
    
    -- Fast bypass teleport (moves in chunks per frame)
    isTPing = true
    task.spawn(function()
        local isAnchoredOriginal = false
        if root:IsA("BasePart") then
            isAnchoredOriginal = root.Anchored
            root.Anchored = true
        end

        local stepDist = 350
        local steps = math.ceil(dist / stepDist)
        
        for i = 1, steps do
            if not root or not root.Parent or not model.Parent then break end
            local alpha = i / steps
            local currentPos = startPos:Lerp(finalPos, alpha)
            model:PivotTo(CFrame.new(currentPos))
            if root:IsA("BasePart") then
                root.AssemblyLinearVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end
        
        if root:IsA("BasePart") and root.Parent then
            root.Anchored = isAnchoredOriginal
            root.AssemblyLinearVelocity = Vector3.zero
        end
        if humanoid then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        task.wait(0.2)
        isTPing = false
    end)
end

