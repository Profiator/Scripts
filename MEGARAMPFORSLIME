local function getClosestPlayerToCursor()
    local closestDist = getAimbotFOV()
    local closestPlayer = nil
    
    local mousePos = UserInputService:GetMouseLocation()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlayer = p
                end
            end
        end
    end
    return closestPlayer
end

connectSignal(UserInputService.InputBegan, function(input, gpe)
    if gpe then return end
    local hasWeapon = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") ~= nil
    if input.KeyCode == Enum.KeyCode.Q and isAimbotEnabled() and hasWeapon then
        aimbotTarget = getClosestPlayerToCursor()
    end
end)

connectSignal(UserInputService.InputEnded, function(input, gpe)
    if input.KeyCode == Enum.KeyCode.Q then
        aimbotTarget = nil
        aimbotActive = false
    end
end)

connectSignal(RunService.RenderStepped, function()
    local hasWeapon = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") ~= nil

    -- Update FOV Circle
    if showFOV() and isAimbotEnabled() and hasWeapon then
        fovCircle.Visible = true
        local radius = getAimbotFOV()
        fovCircle.Size = UDim2.new(0, radius * 2, 0, radius * 2)
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = UDim2.new(0, mousePos.X - radius, 0, mousePos.Y - radius)
    else
        fovCircle.Visible = false
    end

    -- Update Aimbot
    if isAimbotEnabled() and hasWeapon and aimbotTarget and aimbotTarget.Character and aimbotTarget.Character:FindFirstChild("Head") and UserInputService:IsKeyDown(Enum.KeyCode.Q) then
        aimbotActive = true
        local headPos = aimbotTarget.Character.Head.Position
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, headPos)
        
        -- Force the character to face the target so weapons shoot correctly in 3rd/1st person
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local lookVector = (Vector3.new(headPos.X, hrp.Position.Y, headPos.Z) - hrp.Position).Unit
            if lookVector.Magnitude > 0 then
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + lookVector)
            end
        end
    else
        aimbotActive = false
    end
end)

-- Hook Mouse.Hit and Raycasts for Silent Aim (No spread, always headshot)
pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    
    mt.__index = newcclosure(function(self, key)
        if aimbotActive and not checkcaller() and aimbotTarget and aimbotTarget.Character and aimbotTarget.Character:FindFirstChild("Head") then
            if typeof(self) == "Instance" and self:IsA("Mouse") then
                if key == "Hit" then
                    return aimbotTarget.Character.Head.CFrame
                elseif key == "Target" then
                    return aimbotTarget.Character.Head
                elseif key == "UnitRay" then
                    local origin = Camera.CFrame.Position
                    local head = aimbotTarget.Character.Head.Position
                    return Ray.new(origin, (head - origin).Unit)
                end
            end
        end
        return oldIndex(self, key)
    end)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not checkcaller() then
            -- AntiCheat Blocker
            if typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
                local name = string.lower(self.Name)
                if string.find(name, "anticheat") or string.find(name, "ac") or string.find(name, "kick") or string.find(name, "ban") or string.find(name, "report") or string.find(name, "log") then
                    return self:IsA("RemoteFunction") and nil or nil
                end
                if typeof(args[1]) == "string" then
                    local argStr = string.lower(args[1])
                    if string.find(argStr, "fly") or string.find(argStr, "speed") or string.find(argStr, "exploit") or string.find(argStr, "hack") or string.find(argStr, "teleport") then
                        return self:IsA("RemoteFunction") and nil or nil
                    end
                end
            end
            
            -- Silent Aim
            if aimbotActive and aimbotTarget and aimbotTarget.Character and aimbotTarget.Character:FindFirstChild("Head") then
                local head = aimbotTarget.Character.Head
                if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                    local origin = args[1].Origin
                    local direction = (head.Position - origin).Unit * args[1].Direction.Magnitude
                    args[1] = Ray.new(origin, direction)
                    return oldNamecall(self, unpack(args))
                elseif method == "Raycast" then
                    local origin = args[1]
                    local direction = (head.Position - origin).Unit * args[2].Magnitude
                    args[2] = direction
                    return oldNamecall(self, unpack(args))
                elseif method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                    local origin = self.CFrame.Position
                    return Ray.new(origin, (head.Position - origin).Unit)
                end
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
end)


