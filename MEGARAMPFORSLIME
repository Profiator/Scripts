-- Hook Mouse.Hit and Raycasts for Silent Aim (No spread, always headshot)
pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    
    mt.__index = newcclosure(function(self, key)
        if not _G.SanDiegoActive then return oldIndex(self, key) end
        if not checkcaller() and typeof(self) == "Instance" then
            if key == "FloorMaterial" or key == "WalkSpeed" or key == "Velocity" or key == "AssemblyLinearVelocity" or key == "Hit" or key == "Target" or key == "UnitRay" then
                if key == "WalkSpeed" or key == "FloorMaterial" then
                    local class = oldIndex(self, "ClassName")
                    if class == "Humanoid" then
                        if key == "WalkSpeed" and isCustomSpeed() then return 16 end
                        if key == "FloorMaterial" and (isFlyEnabled() or isCustomSpeed() or isTPing) then return Enum.Material.Plastic end
                    end
                elseif key == "Velocity" or key == "AssemblyLinearVelocity" then
                    local name = oldIndex(self, "Name")
                    if name == "HumanoidRootPart" then
                        if isFlyEnabled() or isCustomSpeed() or isTPing then
                            return Vector3.zero
                        end
                    end
                elseif key == "Hit" or key == "Target" or key == "UnitRay" then
                    if aimbotActive and aimbotTarget then
                        local class = oldIndex(self, "ClassName")
                        if class == "PlayerMouse" or class == "Mouse" then
                            local char = aimbotTarget.Character
                            local head = char and char:FindFirstChild("Head")
                            if head then
                                if key == "Hit" then
                                    return head.CFrame
                                elseif key == "Target" then
                                    return head
                                elseif key == "UnitRay" then
                                    local origin = Camera.CFrame.Position
                                    return Ray.new(origin, (head.Position - origin).Unit)
                                end
                            end
                        end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    
    local blockedRemotes = {}
    
    mt.__namecall = newcclosure(function(self, ...)
        if not _G.SanDiegoActive then return oldNamecall(self, ...) end
        local method = getnamecallmethod()
        
        if not checkcaller() and typeof(self) == "Instance" then
            if method == "GetState" then
                local class = oldIndex(self, "ClassName")
                if class == "Humanoid" then
                    if isFlyEnabled() or isCustomSpeed() or isTPing then
                        return Enum.HumanoidStateType.Running
                    end
                end
            elseif method == "FireServer" or method == "InvokeServer" then
                local name = oldIndex(self, "Name")
                
                if aimbotActive and aimbotTarget then
                    local lowerName = string.lower(name)
                    if string.find(lowerName, "shoot") or string.find(lowerName, "fire") or string.find(lowerName, "hit") or string.find(lowerName, "bullet") or string.find(lowerName, "gun") or string.find(lowerName, "dmg") or string.find(lowerName, "damage") or string.find(lowerName, "attack") then
                        local char = aimbotTarget.Character
                        local head = char and char:FindFirstChild("Head")
                        if head then
                            local args = {...}
                            local changed = false
                            for i, v in ipairs(args) do
                                if typeof(v) == "Ray" then
                                    args[i] = Ray.new(v.Origin, (head.Position - v.Origin).Unit * 1000)
                                    changed = true
                                elseif typeof(v) == "Vector3" then
                                    local myRoot = getCharRoot()
                                    if myRoot and (v - myRoot.Position).Magnitude > 2 then
                                        if v.Magnitude < 10 then 
                                            args[i] = (head.Position - myRoot.Position).Unit
                                        else
                                            args[i] = head.Position
                                        end
                                        changed = true
                                    end
                                elseif typeof(v) == "CFrame" then
                                    local myRoot = getCharRoot()
                                    if myRoot and (v.Position - myRoot.Position).Magnitude > 2 then
                                        args[i] = head.CFrame
                                        changed = true
                                    end
                                elseif typeof(v) == "Instance" then
                                    if v:IsA("BasePart") or v:IsA("Model") then
                                        if v.Parent ~= LocalPlayer.Character and not v:IsDescendantOf(LocalPlayer.Character) then
                                            args[i] = head
                                            changed = true
                                        end
                                    end
                                end
                            end
                            if changed then
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
                
                if isAnalyzing then
                    local args = {...}
                    local strArgs = {}
                    for i = 1, math.min(#args, 5) do
                        local v = args[i]
                        local t = type(v)
                        if t == "string" then
                            strArgs[i] = '"' .. string.sub(v, 1, 30) .. '"'
                        elseif t == "number" or t == "boolean" then
                            strArgs[i] = tostring(v)
                        elseif typeof(v) == "Instance" then
                            local cName = "Instance"
                            pcall(function() cName = oldIndex(v, "ClassName") end)
                            strArgs[i] = cName
                        else
                            strArgs[i] = typeof(v)
                        end
                    end
                    local msg = "[" .. method .. "] " .. tostring(name) .. " | " .. table.concat(strArgs, ", ")
                    
                    task.spawn(function()
                        if #loggedEvents > 50 then table.remove(loggedEvents, 1) end
                        table.insert(loggedEvents, msg)
                        pendingLogs = true
                    end)
                end
                
                local isBlocked = blockedRemotes[name]
                if isBlocked == nil then
                    local lowerName = string.lower(name)
                    -- Строгая проверка, чтобы не блокировать 'Character', 'Interact', 'Backpack' (содержат ac) или 'Dialog' (содержит log)
                    if string.find(lowerName, "anticheat") or string.find(lowerName, "anti_cheat") or lowerName == "ac" or string.find(lowerName, "kick") or string.find(lowerName, "ban") or lowerName == "crash" or string.find(lowerName, "report") then
                        blockedRemotes[name] = true
                        isBlocked = true
                    else
                        blockedRemotes[name] = false
                        isBlocked = false
                    end
                end
                if isBlocked then
                    return method == "InvokeServer" and nil or nil
                end
            end
            
            -- Silent Aim
            if aimbotActive and aimbotTarget then
                if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast" or method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                    local char = aimbotTarget.Character
                    local head = char and char:FindFirstChild("Head")
                    if head then
                        if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                            local args = {...}
                            if typeof(args[1]) == "Ray" then
                                local origin = args[1].Origin
                                local direction = (head.Position - origin).Unit * args[1].Direction.Magnitude
                                args[1] = Ray.new(origin, direction)
                                return oldNamecall(self, unpack(args))
                            end
                        elseif method == "Raycast" then
                            local args = {...}
                            if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                                local origin = args[1]
                                local direction = (head.Position - origin).Unit * args[2].Magnitude
                                args[2] = direction
                                return oldNamecall(self, unpack(args))
                            end
                        elseif method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                            local origin = oldIndex(self, "CFrame").Position
                            return Ray.new(origin, (head.Position - origin).Unit)
                        end
                    end
                end
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
end)


