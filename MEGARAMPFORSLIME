local ProximityPromptService = game:GetService("ProximityPromptService")
connectSignal(ProximityPromptService.PromptTriggered, function(prompt, player)
    if player == LocalPlayer and isRecording() then
        local root = getCharRoot()
        local pos = root and root.Position or Vector3.zero
        local lastPoint = routePoints[#routePoints]
        if lastPoint and lastPoint.type == "interact" and lastPoint.prompt == prompt then
            if tick() - (lastPoint.time or 0) < 0.5 then
                return
            end
        end
        table.insert(routePoints, { type = "interact", prompt = prompt, pos = pos, time = tick() })
        clearRouteBtn.Text = "Очистить маршрут (Точек: " .. #routePoints .. ")"
    end
end)

connectSignal(RunService.Heartbeat, function(dt)
    isFarmPlaying = isPlaying()
    if isRecording() then
        if isPlaying() then setPlaying(false) end
        recordTimer = recordTimer + dt
        if recordTimer >= 0.2 then
            recordTimer = 0
            local root = getCharRoot()
            if root then
                -- Не спамить точки, если стоим на месте
                local add = true
                local lastPoint = routePoints[#routePoints]
                if lastPoint then
                    if lastPoint.type == "move" and (lastPoint.pos - root.Position).Magnitude < 2 then
                        add = false
                    elseif lastPoint.type == "interact" and (lastPoint.pos - root.Position).Magnitude < 2 then
                        add = false
                    end
                end
                if add then
                    table.insert(routePoints, { type = "move", pos = root.Position })
                    clearRouteBtn.Text = "Очистить маршрут (Точек: " .. #routePoints .. ")"
                end
            end
        end
    else
        recordTimer = 0
    end

    if isPlaying() then
        if isRecording() then setRecording(false) end
        if #routePoints == 0 then
            setPlaying(false)
            return
        end
        local root = getCharRoot()
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if root and humanoid then
            if farmInteracting then
                humanoid:MoveTo(root.Position)
                return
            end
            
            local currentPoint = routePoints[playIndex]
            local targetPos = currentPoint.pos
            local distXZ = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude

            if currentPoint.type == "move" then
                if distXZ < 3 then
                    playIndex = playIndex + 1
                    if playIndex > #routePoints then playIndex = 1 end
                    playStuckTimer = 0
                else
                    humanoid:MoveTo(targetPos)
                    if targetPos.Y - root.Position.Y > 2 then
                        humanoid.Jump = true
                    end
                    playStuckTimer = playStuckTimer + dt
                    if playStuckTimer > 2 then
                        humanoid.Jump = true
                        playStuckTimer = 0
                    end
                end
            elseif currentPoint.type == "interact" then
                if distXZ < 10 then
                    farmInteracting = true
                    humanoid:MoveTo(root.Position)
                    if currentPoint.prompt and currentPoint.prompt.Parent then
                        task.spawn(function()
                            for i = 1, 3 do
                                if fireproximityprompt then
                                    fireproximityprompt(currentPoint.prompt)
                                else
                                    currentPoint.prompt:InputHoldBegin()
                                    task.wait(currentPoint.prompt.HoldDuration > 0 and currentPoint.prompt.HoldDuration or 0.1)
                                    currentPoint.prompt:InputHoldEnd()
                                end
                                task.wait(0.2)
                            end
                            playIndex = playIndex + 1
                            if playIndex > #routePoints then playIndex = 1 end
                            playStuckTimer = 0
                            farmInteracting = false
                        end)
                    else
                        playIndex = playIndex + 1
                        if playIndex > #routePoints then playIndex = 1 end
                        playStuckTimer = 0
                        farmInteracting = false
                    end
                else
                    humanoid:MoveTo(targetPos)
                    if targetPos.Y - root.Position.Y > 2 then
                        humanoid.Jump = true
                    end
                    playStuckTimer = playStuckTimer + dt
                    if playStuckTimer > 2 then
                        humanoid.Jump = true
                        playStuckTimer = 0
                    end
                end
            elseif currentPoint.type == "remote" then
                if distXZ < 10 then
                    farmInteracting = true
                    humanoid:MoveTo(root.Position)
                    if currentPoint.instance and currentPoint.instance.Parent then
                        task.spawn(function()
                            for i = 1, 3 do
                                pcall(function()
                                    if currentPoint.method == "FireServer" then
                                        currentPoint.instance:FireServer(unpack(currentPoint.args))
                                    elseif currentPoint.method == "InvokeServer" then
                                        currentPoint.instance:InvokeServer(unpack(currentPoint.args))
                                    end
                                end)
                                task.wait(0.2)
                            end
                            playIndex = playIndex + 1
                            if playIndex > #routePoints then playIndex = 1 end
                            playStuckTimer = 0
                            farmInteracting = false
                        end)
                    else
                        playIndex = playIndex + 1
                        if playIndex > #routePoints then playIndex = 1 end
                        playStuckTimer = 0
                        farmInteracting = false
                    end
                else
                    humanoid:MoveTo(targetPos)
                    if targetPos.Y - root.Position.Y > 2 then
                        humanoid.Jump = true
                    end
                    playStuckTimer = playStuckTimer + dt
                    if playStuckTimer > 2 then
                        humanoid.Jump = true
                        playStuckTimer = 0
                    end
                end
            elseif currentPoint.type == "point3" then
                if distXZ < 6 then
                    farmInteracting = true
                    humanoid:MoveTo(root.Position)
                    task.spawn(function()
                        local repeats = currentPoint.repeatCount or 1
                        for r = 1, repeats do
                            pcall(function()
                                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    for _, prompt in ipairs(Workspace:GetDescendants()) do
                                        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                                            local pPart = prompt.Parent
                                            if pPart and pPart:IsA("BasePart") and (pPart.Position - hrp.Position).Magnitude < 15 then
                                                if fireproximityprompt then
