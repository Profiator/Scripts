-- Функция для Noclip
local function setNoclip(state)
    if not Character then return end
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
    noclipEnabled = state
end

-- Создаём BodyVelocity для управления движением
local function createBodyVelocity()
    if bodyVelocity then bodyVelocity:Destroy() end
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.P = 1e5
    bodyVelocity.Parent = RootPart
    return bodyVelocity
end

-- Функция для движения вперёд
local function driveForward(speed)
    if not RootPart then return end
    local direction = RootPart.CFrame.LookVector
    local vel = direction * speed
    if bodyVelocity then
        bodyVelocity.Velocity = Vector3.new(vel.X, 0, vel.Z)
    end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, nil)
end

-- Функция для сбора бонусов
local function collectBonuses()
    if not CONFIG.CollectBonuses or not RootPart then return end
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name:lower():find("coin") or part.Name:lower():find("bonus") or part.Name:lower():find("multiplier")) then
            if (part.Position - RootPart.Position).Magnitude < 30 then
                -- Просто проезжаем через них – они сами подберутся
            end
        end
    end
end

-- Поиск всех зон (триггеров) на карте
local function findZones()
    local zones = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("zone") or name:find("trigger") or name:find("checkpoint") or name:find("ramp") or name:find("slime") then
                table.insert(zones, obj)
            end
        end
    end
    -- Сортируем по оси Z (если рампа идёт по X – замени Z на X)
    table.sort(zones, function(a, b)
        return a.Position.Z < b.Position.Z
    end)
    return zones
end

-- Телепорт по зонам (для быстрого прохождения)
local function teleportThroughZones()
    local zones = findZones()
    if #zones == 0 then
        print("[WARN] Зоны не найдены, используем супер-скорость.")
        return
    end
    print("[INFO] Найдено зон: " .. #zones)
    for i, zone in ipairs(zones) do
        if not CONFIG.TeleportThroughZones then break end
        local pos = zone.Position + Vector3.new(0, 2, 0) -- чуть выше, чтобы не застрять
        RootPart.CFrame = CFrame.new(pos)
        wait(CONFIG.ZoneDelay)
        if i % 100 == 0 then
            print("[PROGRESS] Пройдено зон: " .. i)
        end
    end
    print("[DONE] Все зоны пройдены! X должен быть огромным.")
end

-- Главный цикл
RunService.Heartbeat:Connect(function()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if not Character then return end
    Humanoid = Character:FindFirstChild("Humanoid")
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not (Humanoid and RootPart) then return end

    if CONFIG.Noclip then
        setNoclip(true)
    end

    if not bodyVelocity then
        createBodyVelocity()
    end

    if CONFIG.AutoDrive then
        local speed = CONFIG.Speed
        if CONFIG.DynamicSpeed then
            local vel = RootPart.Velocity.Magnitude
            if vel < speed * 0.5 then
                speed = speed * 1.1
            end
        end
        driveForward(speed)
    end

    collectBonuses()
end)

