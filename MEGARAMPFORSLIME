        local root, rType, vModel = getCharRoot(false)
        if rType == "Vehicle" and vModel and vModel.PrimaryPart then
            local rx, ry, rz = vModel.PrimaryPart.CFrame:ToOrientation()
            if math.abs(math.deg(rx)) > 80 or math.abs(math.deg(rz)) > 80 then
                vModel:PivotTo(CFrame.new(vModel.PrimaryPart.Position) * CFrame.Angles(0, ry, 0) + Vector3.new(0, 3, 0))
            end
        end
    end
end)

