local function parseCoords(str)
    if not str or str == "" then return nil end
    local x, y, z = str:match("([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
    if x and y and z then
        return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
    end
    return nil
end

local function getCharRoot(forPhysics)
    local char = LocalPlayer.Character
    if not char then return nil, "No Character" end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local vehicle = seat:FindFirstAncestorWhichIsA("Model")
        while vehicle and vehicle.Parent and vehicle.Parent:IsA("Model") and vehicle.Parent ~= Workspace do
            vehicle = vehicle.Parent
        end
        if vehicle then
            if forPhysics then return seat, "Vehicle" end
            return vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart") or seat, "Vehicle", vehicle
        end
        return seat, "Seat"
    end
    return char:FindFirstChild("HumanoidRootPart"), "Character"
end

local function teleportTo(pos, keepExact)
    local root, rootType, vehicleModel = getCharRoot(false)
    if root then
        -- Поднимаем координаты немного выше, чтобы машина не застревала в текстурах
        local rot = root.CFrame.Rotation
        local targetCFrame = keepExact and CFrame.new(pos) * rot or CFrame.new(pos + Vector3.new(0, 3, 0)) * rot
        
        if rootType == "Vehicle" and vehicleModel then
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            vehicleModel:PivotTo(targetCFrame)
        else
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.CFrame = targetCFrame
        end
    end
end

local function safeMove(startPos, endPos, duration)
    local root, rootType, vehicleModel = getCharRoot(false)
    if not root then return end
    
    local startTime = tick()
    local connection
    local moveVelocity = (endPos - startPos) / duration
    
    connection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        local currentPos = startPos:Lerp(endPos, alpha)
        
        local flatDir = Vector3.new(endPos.X - startPos.X, 0, endPos.Z - startPos.Z)
        local dir = flatDir.Magnitude > 0.001 and flatDir.Unit or Vector3.new(0, 0, 1)
        -- Чтобы машина не кувыркалась, смотрим строго прямо
        local cframe = CFrame.new(currentPos, currentPos + dir)
        if rootType == "Vehicle" and vehicleModel then
            for _, part in ipairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = moveVelocity
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            vehicleModel:PivotTo(cframe)
        else
            root.CFrame = cframe
            root.AssemblyLinearVelocity = moveVelocity
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        if alpha >= 1 then
            connection:Disconnect()
        end
    end)
    
    task.wait(duration + 0.1)
    if connection then connection:Disconnect() end
end

