-- MEGA RAMP FOR SLIME
-- CP92 CLEAN EXACT ORIGINAL
--
-- Original LastZone logic preserved:
--   CarSpawn -> wait(1) -> find PlayerName_Auto
--   -> JumpCar -> wait(0.2)
--   -> Checkpoint 92 -> wait(0.2)
--   -> CFrame.new(16.58, 4, 3304.53)
--   -> wait(1) -> OpenBoxClick x10 -> repeat
--
-- IMPORTANT FIX:
-- Stops ALL old LastZone / Equip loops from previously executed versions
-- before starting this script.

-- =========================================================
-- CLEANUP OLD RUNNING VERSIONS
-- =========================================================

_G.LastZone = false
_G.Equip = false

-- Old versions can still be inside:
-- wait(1) + wait(0.2) + wait(0.2) + wait(1)
-- Give them enough time to return to their while condition and terminate.
task.wait(4)

-- Session guard prevents duplicate loops from THIS version.
_G.MegaRampCP92Session = (_G.MegaRampCP92Session or 0) + 1
local SESSION = _G.MegaRampCP92Session

-- =========================================================
-- UI - same library/original layout
-- =========================================================

local CoreGui = game:GetService("CoreGui")
local OldGui = CoreGui:FindFirstChild("ToraScript")

if OldGui then
    OldGui:Destroy()
end

local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew",
    true
))()

local Window = Library:CreateWindow("MEGA RAMP FOR SLIME")

-- =========================================================
-- ORIGINAL LASTZONE LOGIC
-- Only 68 -> 92 and final coordinates changed.
-- =========================================================

local function LastZone(mySession)
    while _G.LastZone and _G.MegaRampCP92Session == mySession do
        wait()

        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame =
            workspace.Progetto.CarSpawn.CFrame

        wait(1)

        for _, find in pairs(workspace:GetChildren()) do
            if not _G.LastZone or _G.MegaRampCP92Session ~= mySession then
                return
            end

            -- EXACT original car identification:
            if find.Name == game.Players.LocalPlayer.Name .. "_Auto" then

                -- EXACT original first teleport:
                find:SetPrimaryPartCFrame(workspace.Progetto.JumpCar.CFrame)
                wait(0.2)

                -- ONLY CHANGE #1:
                -- Original: workspace.Progetto.Checkpoints["68"].CFrame
                find:SetPrimaryPartCFrame(
                    workspace.Progetto.Checkpoints["92"].CFrame
                )
                wait(0.2)

                -- ONLY CHANGE #2:
                -- Original: CFrame.new(-21, 3, 2101)
                find:SetPrimaryPartCFrame(
                    CFrame.new(16.58, 4, 3304.53)
                )
                wait(1)

                -- EXACT original reward calls:
                for _ = 1, 10 do
                    game:GetService("ReplicatedStorage")
                        .Remotes
                        .OpenBoxClick
                        :FireServer()
                end

                wait()
            end
        end
    end
end

-- =========================================================
-- ORIGINAL EQUIP BEST
-- =========================================================

local function Equip(mySession)
    while _G.Equip and _G.MegaRampCP92Session == mySession do
        game:GetService("ReplicatedStorage")
            .Remotes
            .EquipBestInventory
            :FireServer()

        wait(2)
    end
end

-- =========================================================
-- TOGGLES
-- =========================================================

Window:AddToggle({
    text = "Instant LastZone",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.LastZone = value
        print("LastZone: ", value)

        if value then
            -- Make sure only one farm coroutine from this UI activation runs.
            local mySession = _G.MegaRampCP92Session
            spawn(function()
                LastZone(mySession)
            end)
        end
    end,
})

Window:AddToggle({
    text = "Equip Best",
    flag = "toggle",
    state = false,
    callback = function(value)
        _G.Equip = value
        print("Equip: ", value)

        if value then
            local mySession = _G.MegaRampCP92Session
            spawn(function()
                Equip(mySession)
            end)
        end
    end,
})

Window:AddLabel({
    text = "YouTube: Tora IsMe",
})

Library:Init()
