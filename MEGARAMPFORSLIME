-- ==========================================
-- АВТОФАРМ СКОРОСТНОЙ (ТЕЛЕПОРТ ПО ЧЕКПОИНТАМ)
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

-- Переменные
local isFarming = true
local currentIndex = 1
local checkpoints = {}

-- Функция поиска машины (VehicleSeat), в которой сидит игрок
local function GetVehicleSeat()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("VehicleSeat") and v.Occupant == LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            return v
        end
    end
    return nil
end

-- Функция поиска всех чекпоинтов (по надписи X на GUI)
local function FindCheckpoints()
    table.clear(checkpoints)
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            -- Проверяем наличие SurfaceGui или BillboardGui с текстом X
            local gui = v:FindFirstChildOfClass("SurfaceGui") or v:FindFirstChildOfClass("BillboardGui")
            if gui then
                local text = ""
                if gui:FindFirstChildOfClass("TextLabel") then
                    text = gui:FindFirstChildOfClass("TextLabel").Text
                elseif gui:FindFirstChild("TextLabel") then
                    text = gui.TextLabel.Text
                end
                -- Если в тексте есть "x" (например, x250)
                if string.match(text, "x%d") or string.match(text, "X%d") then
                    table.insert(checkpoints, v)
                end
            end
        end
    end
    
    -- Сортируем чекпоинты по их позиции (предполагаем, что трасса идет вдоль оси Z или X)
    -- Если трасса другая, этот шаг можно поменять (например, сортировать по X, если едешь вправо)
    table.sort(checkpoints, function(a, b)
        return a.Position.Z < b.Position.Z -- Или a.Position.X, если трасса идет по X
    end)
    
    return #checkpoints
end

-- Функция телепортации машины к чекпоинту
local function TeleportToTarget(target)
    local seat = GetVehicleSeat()
    if seat then
        local model = seat.Parent
        -- Смотрим на чекпоинт, чтобы машина смотрела вперед
        local newCF = CFrame.new(target.Position + Vector3.new(0, 1, 0), target.Position + Vector3.new(0, 1, 100))
        -- Применяем позицию
        model:PivotTo(newCF)
        -- Сбрасываем скорость/физику, чтобы не падать
        seat.Velocity = Vector3.zero
        seat.AssemblyLinearVelocity = Vector3.zero
    end
end

-- Основной цикл
task.spawn(function()
    while isFarming do
        -- Ищем чекпоинты (обновляем, если они только заспавнились)
        if #checkpoints == 0 then
            FindCheckpoints()
            task.wait(1)
        else
            local target = checkpoints[currentIndex]
            
            if target and target.Parent then
                -- Телепортируем к цели
                TeleportToTarget(target)
                -- Выводим в консоль (как в твоем Output)
                print("Checkpoint UI: " .. currentIndex .. " x" .. currentIndex * 5 .. " Label: x" .. currentIndex * 5)
                
                -- Переходим к следующему
                currentIndex = currentIndex + 1
                
                -- Если дошли до конца, начинаем сначала (фарм бесконечный)
                if currentIndex > #checkpoints then
                    currentIndex = 1
                    task.wait(2) -- Небольшая пауза, если трасса огромная
                end
            else
                -- Если какой-то чекпоинт удалили, идем дальше
                currentIndex = currentIndex + 1
                if currentIndex > #checkpoints then currentIndex = 1 end
            end
        end
        
        task.wait(0.1) -- Скорость фарма (0.1 сек на платформу). Поставь 0.05, если игра успевает засчитывать быстрее.
    end
end)

-- Управление: Нажми F, чтобы включить/выключить автофарм
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.F then
        isFarming = not isFarming
        print("Автофарм: " .. (isFarming and "ВКЛЮЧЕН" or "ВЫКЛЮЧЕН"))
    end
end)

-- Стартовый вывод
print("Скрипт запущен. Ищу чекпоинты...")
FindCheckpoints()
print("Найдено чекпоинтов: " .. #checkpoints .. ". Нажми F для вкл/выкл.")
