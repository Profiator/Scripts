-- Функция для получения текущего X (дальности полёта)
local function getCurrentX()
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    -- В игре X считается по горизонтальному смещению от старта
    -- Обычно это позиция по оси Z или X, смотрим по карте
    return math.abs(root.Position.Z)  -- или X, смотри по факту
end

-- Функция для принудительной установки X (обман)
local function setMaxX()
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    -- Находим самую дальнюю точку на рампе (берём максимальную Z из всех частей карты)
    local maxZ = 0
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name:lower():find("ramp") then
            local z = math.abs(part.Position.Z)
            if z > maxZ then maxZ = z end
        end
    end
    if maxZ > 0 then
        -- Телепортируем игрока на максимальную Z + небольшой запас
        local newPos = Vector3.new(root.Position.X, root.Position.Y, maxZ + 50)
        root.CFrame = CFrame.new(newPos)
        -- Сбрасываем скорость, чтобы не вылететь
        root.Velocity = Vector3.new(0, 0, 0)
    end
end

-- Автофарм: постоянно двигаемся вперёд и собираем монеты
local function autoFarm()
    if not Settings.AutoFarm then return end
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    -- Двигаемся вперёд по направлению рампы
    local direction = root.CFrame.LookVector * 10
    root.Velocity = Vector3.new(direction.X, root.Velocity.Y, direction.Z)
end

-- Ускорение
local function applySpeedHack()
    if not Settings.SpeedHack then return end
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local vel = root.Velocity
    local mult = Settings.SpeedMultiplier or 50
    root.Velocity = Vector3.new(vel.X * mult, vel.Y, vel.Z * mult)
end

-- Анти-падение (не даём упасть с рампы)
local function antiFall()
    if not Settings.AntiFall then return end
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if root.Position.Y < -50 then
        root.CFrame = CFrame.new(root.Position.X, 10, root.Position.Z)
        root.Velocity = Vector3.new(0, 0, 0)
    end
end

-- Телепорт в целевую зону
local function teleportToZone()
    if not Settings.TeleportToZone then return end
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    -- Ищем зону по номеру (чем выше номер, тем дальше)
    local targetZ = Settings.TargetZone * 1000  -- примерный расчёт
    root.CFrame = CFrame.new(Vector3.new(0, 10, targetZ))
end

