local RootPart = Character:WaitForChild("HumanoidRootPart")

-- === НАСТРОЙКИ ===
local Settings = {
    OneMillionMode = false,   -- главный тумблер
    Noclip = true,
    SuperSpeed = true,
    SpeedValue = 999,
    TeleportThroughZones = true,
    ZoneDelay = 0.001,        -- задержка между телепортами (чем меньше, тем быстрее)
    AutoCollect = true,
}

-- === NOCLIP ===
local function setNoclip(state)
    if not Character then return end
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- === ПОИСК ЗОН ===
local function findZones()
    local zones = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("zone") or name:find("trigger") or name:find("checkpoint") or name:find("ramp") or name:find("slime") then
                table.insert(zones, obj)
            end
        end
    end
    -- Сортируем по оси Z (можно заменить на X, если рампа идёт по X)
    table.sort(zones, function(a, b)
        return a.Position.Z < b.Position.Z
    end)
    return zones
end

-- === ТЕЛЕПОРТ ПО ЗОНАМ ===
local function teleportThroughZones()
    local zones = findZones()
    if #zones == 0 then
        print("[WARN] Зоны не найдены, используем супер-скорость.")
        return
    end
    print("[INFO] Найдено зон: " .. #zones)
    for i, zone in ipairs(zones) do
        if not Settings.OneMillionMode then break end
        local pos = zone.Position + Vector3.new(0, 2, 0) -- чуть выше, чтобы не застрять
        RootPart.CFrame = CFrame.new(pos)
        wait(Settings.ZoneDelay)
        -- Обновляем GUI, чтобы показать прогресс
        if i % 100 == 0 then
            print("[PROGRESS] Пройдено зон: " .. i)
        end
    end
    print("[DONE] Все зоны пройдены! X должен быть огромным.")
end

-- === СУПЕР-СКОРОСТЬ ===
local function applySuperSpeed()
    if not Settings.SuperSpeed or not Settings.OneMillionMode then return end
    local vel = RootPart.Velocity
    local dir = RootPart.CFrame.LookVector
    local newVel = dir * Settings.SpeedValue
    RootPart.Velocity = Vector3.new(newVel.X, vel.Y, newVel.Z)
end

-- === АВТО-СБОР (опционально) ===
local function collectBonuses()
    if not Settings.AutoCollect or not Settings.OneMillionMode then return end
    -- просто проезжаем через все части с "coin" или "bonus" – они сами подберутся
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name:lower():find("coin") or part.Name:lower():find("bonus")) then
            if (part.Position - RootPart.Position).Magnitude < 100 then
                -- уже собрано при телепорте
            end
        end
    end
end

-- === ГЛАВНЫЙ ЦИКЛ ===
RunService.Heartbeat:Connect(function()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if not Character then return end
    Humanoid = Character:FindFirstChild("Humanoid")
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not (Humanoid and RootPart) then return end

    if Settings.OneMillionMode then
        -- Noclip
        if Settings.Noclip then
            setNoclip(true)
        end

        -- Супер-скорость (если телепорт не работает)
        applySuperSpeed()

        -- Авто-сбор
        collectBonuses()
    else
        -- Отключаем Noclip, если режим выключен
        setNoclip(false)
    end
end)

-- === КНОПКА ДЛЯ ЗАПУСКА ТЕЛЕПОРТА ПО ЗОНАМ ===
-- (запускается отдельно, чтобы не мешать циклу)
local function startZoneTeleport()
    if not Settings.OneMillionMode then return end
    if Settings.TeleportThroughZones then
        teleportThroughZones()
    end
end

