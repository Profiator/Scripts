-- Динамическое изменение высоты логов
local function updateLogHeight()
    local lines = logText.Text:split("\n")
    local lineCount = #lines
    local lineHeight = 16 -- примерная высота строки
    logText.Size = UDim2.new(1, -10, 0, lineCount * lineHeight + 10)
    logScrolling.CanvasSize = UDim2.new(0, 0, 0, lineCount * lineHeight + 10)
end

-- Переопределим addLog, чтобы обновлять высоту
local oldAddLog = addLog
addLog = function(text)
    oldAddLog(text)
    updateLogHeight()
end

