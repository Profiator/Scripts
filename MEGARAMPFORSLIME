-- Скорость ходьбы / машины
local wasWalkSpeedChanged = false
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            if not isFlyEnabled() then -- Если полет ВЫКЛЮЧЕН, меняем обычную скорость
                if getSpeed() > 16 then
                    humanoid.WalkSpeed = getSpeed()
                    wasWalkSpeedChanged = true
                    
                    -- Попытка ускорить машину (если сидит)
                    if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
                        humanoid.SeatPart.MaxSpeed = getSpeed()
                    end
                elseif wasWalkSpeedChanged then
                    humanoid.WalkSpeed = 16
                    wasWalkSpeedChanged = false
                end
            end
        end
    end
end)

-- Свободный полет (Fly)
local flying = false
local flyBV, flyBG

local function startFly(root)
    if flying then return end
    flying = true
    
    flyBG = Instance.new("BodyGyro")
    flyBG.P = 9e4
    flyBG.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.cframe = root.CFrame
    flyBG.Parent = root
    
    flyBV = Instance.new("BodyVelocity")
    flyBV.velocity = Vector3.new(0, 0, 0)
    flyBV.maxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = root
end

local function stopFly()
    if not flying then return end
    flying = false
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
end

RunService.RenderStepped:Connect(function()
    if isFlyEnabled() then
        local root = getCharRoot()
        if root then
            if not flying or (flyBG and flyBG.Parent ~= root) then
                stopFly()
                startFly(root)
            end
            
            if flying and flyBG and flyBV then
                local camera = Workspace.CurrentCamera
                flyBG.cframe = CFrame.new(camera.CFrame.p, camera.CFrame.p + camera.CFrame.lookVector)
                
                local moveDir = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                
                flyBV.velocity = moveDir.Magnitude > 0 and moveDir.Unit * getSpeed() or Vector3.new(0, 0, 0)
            end
        end
    else
        stopFly()
    end
end)
